---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';

const preplyUrl = 'https://preply.com/en/tutor/8033353';

// Quoted verbatim from the Preply profile's "What my students say" section,
// ratings included (bestRating is 5).
const reviews = [
  {
    name: 'Aleksandr',
    when: 'August 2026',
    rating: 5,
    body: 'I had a great experience learning with Jacob. He helped me prepare for an interview at Amazon, especially behavioral interview. His practical approach with mock interview and structure exercises was very effective.',
  },
  {
    name: 'Henrik',
    when: 'July 2026',
    rating: 5,
    body: 'In the lessons with Jacob, we worked on interview preparation for positions in the tech field. If anyone is in a similar position, like me, to prepare for interviews and exchange knowledge in the CS field, I can highly recommend booking a lesson with him. Jacob is really friendly and puts effort into preparing the lessons. I would for sure book lessons again!',
  },
  {
    name: 'Alex',
    when: 'July 2026',
    rating: 5,
    body: 'Jacob is highly experienced and has been very helpful in helping me understand different topics - not only the basics but the latest developments and trends as well.',
  },
];
---

<BaseLayout
  title="Reviews"
  description="What students say about learning, interview preparation, and coaching sessions with Jacob Hite."
>
  <PageHeader
    eyebrow="Reviews"
    title="In their words"
    lede="Some came to learn computer science, some to get ready for an interview. These are their reviews, quoted verbatim from my Preply tutor profile."
  />

  <section class="section page">
    <div class="reviews">
      {
        reviews.map((r) => (
          <figure class="review reveal">
            <p class="review__stars" aria-label={`Rated ${r.rating} out of 5 stars`}>
              <span aria-hidden="true">{'★'.repeat(r.rating)}</span>
            </p>
            <blockquote>
              <p>{r.body}</p>
            </blockquote>
            <figcaption>
              <span class="review__name">{r.name}</span>
              <span class="review__meta">{r.when}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="reviews__source">
      All of these were left on my <a href={preplyUrl} rel="noopener">Preply tutor profile</a> —
      5.0 across the board — where I teach coding, AI, and CS fundamentals and run interview
      preparation.
    </p>
  </section>

  <ContactCTA
    heading="Want to be the next one?"
    body="Whether it's learning to code, understanding how AI actually works, or an interview you need to be ready for — tell me where you are and where you're trying to get."
  />
</BaseLayout>

<style>
  .reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--s-5);
    align-items: start;
  }

  .review {
    margin: 0;
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }

  .review__stars {
    margin-bottom: var(--s-3);
    color: var(--accent-bright);
    font-size: var(--t-sm);
    letter-spacing: 0.25em;
    line-height: 1;
  }

  .review blockquote {
    margin: 0;
  }

  .review blockquote p {
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .review blockquote p::before {
    content: '“';
  }

  .review blockquote p::after {
    content: '”';
  }

  .review figcaption {
    margin-top: var(--s-4);
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .review__name {
    font-weight: 700;
  }

  .review__meta {
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .reviews__source {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }
</style>
