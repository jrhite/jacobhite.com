---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';
import MerrillCycle from '../components/MerrillCycle.astro';
import SuperMarioEffect from '../components/SuperMarioEffect.astro';
import RespawnGame from '../components/RespawnGame.astro';
import CaesarCipher from '../components/CaesarCipher.astro';
import WordCounter from '../components/WordCounter.astro';

/** Merrill's First Principles, as I actually run them. From my clinical practice write-up. */
const principles = [
  {
    n: '01',
    name: 'Task-centered',
    body: 'The entire curriculum is one artifact: a real application the student builds up step by step. No concept is ever taught "for later." Each one is introduced the moment the app needs it, and the task grows in complexity.',
  },
  {
    n: '02',
    name: 'Activation',
    body: 'Every lesson opens with a warm-up that reviews the previous session by doing — not by me recapping it.',
  },
  {
    n: '03',
    name: 'Demonstration',
    body: 'I introduce and play with the new tool using example data, while the student watches.',
  },
  {
    n: '04',
    name: 'Application',
    body: 'The student practices a similar task while I watch. They explain each piece back to me as it lands — the AI\'s lines included — and I coach by question, not by answer.',
  },
  {
    n: '05',
    name: 'Integration',
    body: 'The student uses the app as their real to-do list, and keeps a running list of its annoyances and the features they wish it had. Those lists become the next lessons, which they now drive.',
  },
];

const journal = [
  'What did I ask for?',
  'What did the AI change?',
  'What did I verify myself?',
  'What could be wrong?',
  'Why did I accept or reject the change?',
];

const graded = [
  'The quality of their requirements',
  'Their ability to explain generated code',
  'Test coverage, and test quality',
  'Debugging method',
  'Architectural trade-offs',
  'Security awareness',
  'Git and checkpoint discipline',
  'Quality of user feedback',
  'Their final engineering postmortem',
];

const weeks = [
  {
    w: '1',
    t: 'Add a task, see your tasks',
    d: 'A prompt, a list in memory, and one decision. It runs in the terminal, and it is already theirs.',
  },
  {
    w: '2',
    t: 'The list in a browser',
    d: 'A text box, a button, and the tasks on screen. Somebody other than the author can use it now.',
  },
  {
    w: '3',
    t: 'The list survives a refresh',
    d: 'Storage — and the moment a task stops being a string and becomes a record with an id, a title, and a done flag.',
  },
  {
    w: '4',
    t: 'Your list, not everybody\'s',
    d: 'Accounts and permissions. Who you are and which tasks you may touch turn out to be two different questions.',
  },
  {
    w: '5',
    t: 'Due dates that reach you',
    d: 'A calendar or notification API: rate limits, webhooks, and what the list should do when the other service is down.',
  },
  {
    w: '6',
    t: 'Proving "done" means done',
    d: '"The code runs" is not "checking a task off works" is not "the list feels right at 7am."',
  },
  {
    w: '7',
    t: "Other people's tasks",
    d: 'Deployed, with real users putting real errands in it — and a rollback plan for the morning it goes wrong.',
  },
  {
    w: '8',
    t: 'The annoyance list',
    d: 'Everything about their own to-do app that irritates them becomes the refactor, and the postmortem gets written down.',
  },
];
---

<BaseLayout
  title="Teaching"
  description="How I teach programming: one real application built line by line, Merrill's First Principles of Instruction, and a curriculum where AI writes code but the student owns every decision."
>
  <PageHeader
    eyebrow="Teaching"
    title="One app. AI in the loop. Every line explained."
    lede="The whole curriculum is a single artifact the student builds from nothing, with AI as a working partner rather than a shortcut. Every concept arrives the moment the app needs it — and nothing stays in the codebase until the student can explain it, including the lines the AI wrote."
  />

  <section class="section page">
    <div class="lead-grid">
      <div class="prose">
        <h2>Why one app, and not twelve exercises</h2>
        <p>
          A folder of disconnected exercises teaches you that programming is a series of puzzles
          somebody else already solved. Building one real thing over a term teaches you the actual
          job: deciding what it should do, discovering you were wrong, and changing it.
        </p>
        <p>
          So the "curriculum" is one application, built over a term. There isn't a fixed syllabus
          behind it — every student is different, and what they actually want to build is usually
          the thing worth building.
        </p>
        <p>
          The default, and where most people start, is a to-do list. It begins as a variable and a
          print statement. By the end it has a database, accounts, tests, and real users — and at no
          point did the student learn something whose purpose was "you'll need this later."
        </p>
        <p>
          The last principle is the one that matters most: they use the app as
          their <em>real</em> to-do list, and keep a list of everything that annoys them about it. That list becomes the
          syllabus, and now they're the one setting it.
        </p>
      </div>

      <aside class="callout">
        <p class="eyebrow">The rule that surprises people</p>
        <p class="callout__big">No line stays until you can explain it.</p>
        <p class="muted">
          Especially the lines the AI wrote. You read it back to me — what it does, why it's there,
          what breaks if it's wrong. Can't explain it, it comes out. Typing speed was never the
          skill. Owning the code is.
        </p>
      </aside>
    </div>
  </section>

  <section class="section page" id="hands-on">
    <p class="eyebrow">What it feels like</p>
    <h2 class="section__title">Fun is the method, and getting your hands on it is the lesson</h2>
    <p class="lede prose">
      There is a formal framework under all of this, and it is the next section down. But two
      things decide whether any of it lands, and they are easier to show than to argue about — so
      this part is not a description. It runs, you can edit it, and you are meant to.
    </p>

    <ul class="stance">
      <li class="stance__card reveal">
        <h3>Fun is not decoration</h3>
        <p class="muted">
          A student who is enjoying themselves attempts the harder thing, and attempting the harder
          thing is the entire mechanism. Play is not the sugar around the lesson — it is what makes
          somebody willing to be wrong in front of you, which is the precondition for learning
          anything at all.
        </p>
      </li>
      <li class="stance__card reveal">
        <h3>Hands on, and unafraid</h3>
        <p class="muted">
          Running code beside the code that produced it, editable, with nothing punishing a bad
          edit. Breaking it isn't the point — being in it is: changing a number because you
          wondered what it did, and finding out. Things do break, and that is fine; it is the
          evidence you were actually involved rather than watching. Nothing here scores you or
          keeps a streak, so there is nothing to be careful about — and somebody with nothing to
          be careful about is still enjoying it an hour later.
        </p>
      </li>
    </ul>

    <p class="framing">
      This first one isn't a code demo. Before anyone writes a line, something has to be true about
      the room — that being wrong here is cheap, and that trying again is the expected move rather
      than an admission. Get that part wrong and nobody guesses out loud for the rest of the term,
      however good the lesson after it is.
    </p>

    <article class="toy" id="two-framings">
      <header class="toy__head">
        <p class="eyebrow">Before the code · Learning science</p>
        <h3>One puzzle, two framings</h3>
        <p class="lede prose">
          Two people get the same puzzle. One is told a wrong guess costs five points; the other is
          just told to try again. Nothing else differs. Play either version, notice how you feel
          about guessing — the numbers come after.
        </p>
      </header>

      <div class="toy__body">
        <SuperMarioEffect />
      </div>

      <p class="credit">
        The effect this demonstrates is Mark Rober's, named the Super Mario Effect and shown in his
        2018 TEDxPenn talk{' '}
        <a
          href="https://www.ted.com/talks/mark_rober_the_super_mario_effect_tricking_your_brain_into_learning_more"
          rel="noopener">The Super Mario Effect: tricking your brain into learning more</a
        >. The idea, the coding challenge and the numbers in it are his; the toys on this page are
        my own restaging of them for a classroom.
      </p>
    </article>

    <p class="framing">
      Everything below is code, and the rule you just felt is still the one running underneath it.
      Change a number, see what it does, change it back — that loop is the whole method, and these
      are the smallest places I can show it to you.
    </p>

    <article class="toy" id="super-mario-effect">
      <header class="toy__head">
        <p class="eyebrow">Loops, state, a little physics</p>
        <h3>The Super Mario Effect</h3>
        <p class="lede prose">
          Mario doesn't tell you you're a bad person when you fall in a pit. He puts you back at the
          start of the level. Miss this one a few times on purpose, then read the rule beside it and
          notice what isn't in there — the comment that says <code>// no points lost. no lecture.</code>
          is sitting on the only line where a punishment could go. Put <code>world.lose(5)</code> on
          it, or press <em>Punish the miss</em>, and watch the page argue with itself.
        </p>
      </header>
      <div class="toy__body">
        <RespawnGame />
      </div>
    </article>

    <article class="toy" id="caesar-cipher">
      <header class="toy__head">
        <p class="eyebrow">Strings, loops, functions</p>
        <h3>A Caesar cipher</h3>
        <p class="lede prose">
          Shift every letter forward. Easy — until <code>z</code> needs to become <code>c</code>.
          Drag the shift and watch the red cells: that's the wraparound, and that's what
          <code>% 26</code> is for.
        </p>
      </header>
      <div class="toy__body">
        <CaesarCipher />
      </div>
    </article>

    <article class="toy" id="word-counter">
      <header class="toy__head">
        <p class="eyebrow">Objects</p>
        <h3>An object as a counter</h3>
        <p class="lede prose">
          An array stores values by position. An object stores them by key — which makes it a
          tally sheet. Paste anything in and watch the keys appear.
        </p>
      </header>
      <div class="toy__body">
        <WordCounter />
      </div>
    </article>
  </section>

  <section class="section page">
    <p class="eyebrow">The framework</p>
    <h2 class="section__title">Merrill's First Principles, in practice</h2>
    {/* Lede, then the five in full, then the diagram that shows how they cycle. */}
    <p class="lede prose framework__note">
      My clinical practice is built on Merrill's First Principles of Instruction. Here is what each
      one actually looks like on a Tuesday.
    </p>

    <ol class="principles">
      {
        principles.map((p) => (
          <li class="principle reveal">
            <span class="principle__n" aria-hidden="true">
              {p.n}
            </span>
            <h3>{p.name}</h3>
            <p class="muted">{p.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="framework">
      <MerrillCycle />
    </div>

    <p class="refs muted">
      Merrill, M. D. (2002). First principles of instruction. <em>Educational Technology Research
      and Development, 50</em>(3), 43–59.
      <a href="https://doi.org/10.1007/BF02505024">https://doi.org/10.1007/BF02505024</a><br />
      Merrill, M. D. (2013). <em>First principles of instruction: Identifying and designing
      effective, efficient, and engaging instruction.</em> Pfeiffer.
    </p>
  </section>

  <section class="section ladder-section">
    <div class="page">
      <p class="eyebrow">The shape of a term</p>
      <h2 class="section__title">Eight weeks, one thing, getting harder</h2>
      <p class="lede prose">
        Each week the to-do list gains a capability, and the student gains the concern that arrives with
        it. The final assessment is their own app, with real users — not a zip file that only runs on
        my laptop.
      </p>

      <ol class="ladder">
        {
          weeks.map((week) => (
            <li class="rung reveal">
              <span class="rung__w">Week {week.w}</span>
              <span class="rung__t">{week.t}</span>
              <span class="rung__d muted">{week.d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section page">
    <div class="two-up">
      <div>
        <p class="eyebrow">Evidence of judgement</p>
        <h2 class="section__title">The engineering journal</h2>
        <p class="prose muted">
          Every significant AI-assisted change gets five sentences. Not to create paperwork — to
          create a trail showing that a person, not a model, made the call.
        </p>
        <ol class="journal">
          {journal.map((q) => <li>{q}</li>)}
        </ol>
      </div>

      <div>
        <p class="eyebrow">Assessment</p>
        <h2 class="section__title">What I actually grade</h2>
        <p class="prose muted">
          Notice what isn't on this list: how much code you produced. In a world where code is cheap,
          grading volume grades the wrong thing.
        </p>
        <ul class="graded">
          {graded.map((g) => <li>{g}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <ContactCTA
    heading="Ready to see it up close?"
    body="Whether it's a student, a school, or your own return to code — tell me what you want to build and I'll tell you how I'd teach it."
  />
</BaseLayout>

<style>
  .lead-grid {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 60rem) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .callout {
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent-bright);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    padding: var(--s-5);
    box-shadow: var(--shadow-sm);
  }

  .callout__big {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-block: var(--s-3);
  }

  .section__title {
    margin-block: var(--s-3) var(--s-4);
  }

  /* ---- principles ---- */

  .framework {
    display: flex;
    justify-content: center;
    margin-top: var(--s-6);
    margin-bottom: var(--s-6);
  }

  /* Introduces the diagram directly below it, so it sits on the same centre
     axis. The section title above already supplies the space it needs. */
  .framework__note {
    margin-inline: auto;
    text-align: center;
  }

  /* Six columns so a card can span two and the short last row can sit on the
     half-column offsets — five cards otherwise leave the bottom two shoved
     against the left edge under a full row of three. */
  .principles {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(6, 1fr);
  }

  .principle {
    grid-column: span 2;
  }

  .principle:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .principle:nth-child(5) {
    grid-column: 4 / span 2;
  }

  @media (max-width: 62rem) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }

    .principle,
    .principle:nth-child(4) {
      grid-column: auto;
    }

    /* Odd one out on a two-up grid — center it rather than leave a gap. */
    .principle:nth-child(5) {
      grid-column: 1 / -1;
      max-width: calc(50% - (var(--s-4) / 2));
      margin-inline: auto;
    }
  }

  @media (max-width: 40rem) {
    .principles {
      grid-template-columns: 1fr;
    }

    .principle:nth-child(5) {
      grid-column: auto;
      max-width: none;
    }
  }

  .principle {
    padding: var(--s-5);
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    position: relative;
    overflow: hidden;
  }

  .principle__n {
    position: absolute;
    top: -0.15em;
    right: 0.1em;
    font-family: var(--f-display);
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--accent-soft);
    line-height: 1;
    pointer-events: none;
  }

  .principle h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-3);
    position: relative;
  }

  .refs {
    margin-top: var(--s-6);
    font-size: var(--t-sm);
    max-width: var(--measure);
    line-height: 1.7;
  }

  /* ---- ladder ---- */

  .ladder-section {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }

  .ladder {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: 2px;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .rung {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-5);
    background: var(--bg-raised);
    transition: background var(--dur) var(--ease);
  }

  .rung:hover {
    background: var(--accent-soft);
  }

  @media (min-width: 48rem) {
    .rung {
      grid-template-columns: 6rem minmax(0, 14rem) minmax(0, 1fr);
      gap: var(--s-5);
      align-items: baseline;
    }
  }

  .rung__w {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-weight: 700;
  }

  .rung__t {
    font-weight: 700;
  }

  .rung__d {
    font-size: var(--t-sm);
  }

  /* ---- two-up ---- */

  .two-up {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 56rem) {
    .two-up {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .journal,
  .graded {
    margin-top: var(--s-5);
    padding-left: 0;
    list-style: none;
  }

  .journal {
    counter-reset: j;
  }

  .journal li {
    counter-increment: j;
    position: relative;
    padding: var(--s-3) 0 var(--s-3) var(--s-6);
    border-bottom: 1px solid var(--border);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
  }

  .journal li::before {
    content: counter(j);
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .graded li {
    position: relative;
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    font-size: var(--t-sm);
  }

  .graded li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-weight: 700;
  }

  /* ---- cta ---- */

  /* ---- the two stance principles, and the toys that evidence them ---- */

  .stance {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 var(--s-8);
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .stance__card {
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }


  .stance__card h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-3);
  }

  /* Connective narration at section level, not inside a toy: it frames the Mario
     piece as a teaching demonstration rather than a code demo, then hands off to
     the code toys. Body size and muted on purpose — the toy ledes below it
     should stay the loudest thing in each block. */
  .framing {
    max-width: var(--measure);
    margin-bottom: var(--s-8);
    color: var(--text-muted);
  }

  .toy {
    scroll-margin-top: 6rem;
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-8);
    border-bottom: 1px solid var(--border);
  }

  .toy:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .toy__head h3 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }

  /* Attribution, not body copy — it sits under the game it credits, close
     enough to belong to it but quiet enough not to read as the next lesson.

     Not `var(--measure)`: that is 68ch, and `ch` resolves against the element's
     own font-size, so at --t-sm this paragraph wrapped roughly 1.4x narrower
     than the --t-lg lede above it and left a ragged short column. A rem measure
     is font-size independent, so both wrap on the same right edge. */
  .credit {
    max-width: 47rem;
    margin-top: var(--s-5);
    margin-inline: auto;
    text-align: center;
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .toy__body {
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

</style>
