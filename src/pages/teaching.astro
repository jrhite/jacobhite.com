---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SectionNav from '../components/SectionNav.astro';
import SuperMarioEffect from '../components/SuperMarioEffect.astro';
import RespawnGame from '../components/RespawnGame.astro';
import CaesarCipher from '../components/CaesarCipher.astro';

/**
 * The in-page table of contents. In document order, and short enough to sit on
 * one line of a phone.
 * These label the sections rather than restating their
 * headings, which are full sentences and would not fit.
 */
const sections = [
  { id: 'why-one-app', label: 'Why one app' },
  { id: 'hands-on', label: 'Hands on' },
  { id: 'eight-weeks', label: 'Example term' },
  { id: 'assessment', label: 'Assessment' },
  { id: 'fit', label: 'Fit' },
];

const journal = [
  'What did I ask for?',
  'What did the AI change?',
  'What did I verify myself?',
  'What could be wrong?',
  'Why did I accept or reject the change?',
];

const graded = [
  'The quality of their requirements',
  'Their ability to explain generated code',
  'Test coverage, and test quality',
  'Debugging method',
  'Architectural trade-offs',
  'Security awareness',
  'Git and checkpoint discipline',
  'Quality of user feedback',
  'Their final engineering postmortem',
];

/**
 * The ranges. Every concrete structure on this page (the to-do list, the eight
 * weeks, the grading list) is one setting out of several, and this is where
 * each one gets its range,
 * so a visitor whose class, clock or project looks
 * nothing like the worked example can place themselves without asking first.
 */
const fits = [
  {
    label: "Who's in the room",
    body: 'Grades 9–12, adults starting from nothing, and working engineers picking up a part of the stack they never touched. The vocabulary and the pace change; the loop underneath does not.',
  },
  {
    label: 'The format',
    body: 'One-to-one, a small group, or a full class. In person, or online across time zones. A weekly hour and a shared screen is enough to run all of it.',
  },
  {
    label: 'The project',
    body: 'A to-do list is the worked example on this page, because it walks through the core concepts in a natural order. A game, a bot, a scoreboard, a tool for a family business. I would rather teach the one you already care about.',
  },
  {
    label: 'The stack',
    body: 'Python or JavaScript to start, then wherever the project actually points: web front to back, databases, APIs, deploys. My own work was large production systems, so following your project costs less than redirecting it.',
  },
  {
    label: 'The clock',
    body: 'A full term, an eight-week unit, a run of Saturdays, or an hour a week for as long as it stays useful. Short formats drop rungs rather than rushing them.',
  },
  {
    label: 'The paperwork',
    body: "A school's existing curriculum, standards and rubric: this maps onto them rather than competing with them. Or none at all, if you just want the thing to exist.",
  },
];

const weeks = [
  {
    w: '1',
    t: 'Add a task, see your tasks',
    d: 'A prompt, a list in memory, and one decision. It runs in the terminal, and it is already theirs.',
  },
  {
    w: '2',
    t: 'The list in a browser',
    d: 'A text box, a button, and the tasks on screen. Somebody other than the author can use it now.',
  },
  {
    w: '3',
    t: 'The list survives a refresh',
    d: 'Storage, and the moment a task stops being a string and becomes a record with an id, a title, and a done flag.',
  },
  {
    w: '4',
    t: 'Your list, not everybody\'s',
    d: 'Accounts and permissions. Who you are and which tasks you may touch turn out to be two different questions.',
  },
  {
    w: '5',
    t: 'Due dates that reach you',
    d: 'A calendar or notification API: rate limits, webhooks, and what the list should do when the other service is down.',
  },
  {
    w: '6',
    t: 'Proving "done" means done',
    d: '"The code runs" is not "checking a task off works" is not "the list feels right at 7am."',
  },
  {
    w: '7',
    t: "Other people's tasks",
    d: 'Deployed, with real users putting real errands in it, and a rollback plan for the morning it goes wrong.',
  },
  {
    w: '8',
    t: 'The annoyance list',
    d: 'Everything about their own to-do app that irritates them becomes the refactor, and the postmortem gets written down.',
  },
];
---

<BaseLayout
  title="Teaching"
  description="How I teach programming: one real application built line by line, Merrill's First Principles of Instruction, and a structure that adapts to the student, the school and the schedule, with AI writing code and the student owning the decisions."
>
  <PageHeader
    eyebrow="Teaching"
    title="One real project. AI in the loop. Code you can explain."
    lede="The curriculum is usually one thing the student builds from nothing, with AI as a working partner rather than a shortcut, and concepts arriving when the project needs them. What follows is the version I would run given a blank page: a worked example, not a package. Which project, how long, how fast, and what gets graded all get rebuilt around the student, the school, and the time we actually have."
  />

  <SectionNav sections={sections} label="Sections of this page" />

  <section class="section page" id="why-one-app">
    <div class="lead-grid">
      <div class="prose">
        <h2>Why one app, and not twelve exercises</h2>
        <p>
          A folder of disconnected exercises teaches you that programming is a series of puzzles
          somebody else already solved. Building one real thing over a term teaches you the actual
          job: deciding what it should do, discovering you were wrong, and changing it.
        </p>
        <p>
          So there isn't a fixed syllabus behind it. Every student is different, and what they
          actually want to build is usually the thing worth building.
        </p>
        <p>
          The example I use throughout this page is a to-do list. It begins as a variable and a
          print statement. By the end it has a database, accounts, tests, and real users, and at no point did the student learn something whose purpose was "you'll need this later." I
          picked it because it reaches the concepts in a sensible order without needing a premise
          explained first, not because it is the thing to build.
        </p>
        <p>
          The part that matters most comes last. They use what they built for <em>real</em>: the to-do list becomes the list they actually run their
          week on, and everything that annoys
          them about it becomes the syllabus, which they are now the one setting.
        </p>
      </div>

      <aside class="callout">
        <p class="eyebrow">The part I hold to</p>
        <p class="callout__big">You should be able to explain what you shipped.</p>
        <p class="muted">
          Especially the lines the AI wrote. You read it back to me: what it does, why it's there,
          what breaks if it's wrong. When that comes out shaky, it isn't a penalty; it's just the
          next thing we work on, and sometimes it means the code comes back out. Typing speed was
          never the skill. Owning the code is.
        </p>
      </aside>
    </div>
  </section>

  <section class="section page" id="hands-on">
    <p class="eyebrow">What it feels like</p>
    <h2 class="section__title">Fun is the method, and getting your hands on it is the lesson</h2>
    <p class="lede prose">
      There is a formal framework under all of this: Merrill's First Principles, written up on
      my <a href="/portfolio/clinical-practice">clinical practice</a> page. But two things decide
      whether any of it lands, and they are easier to show than to argue about, so this part is
      not a description. It runs, you can edit it, and you are meant to.
    </p>

    <ul class="stance">
      <li class="stance__card reveal">
        <h3>Fun is not decoration</h3>
        <p class="muted">
          A student who is enjoying themselves attempts the harder thing, and attempting the harder
          thing is the entire mechanism. Play is not the sugar around the lesson. It is what makes
          somebody willing to be wrong in front of you, which is the precondition for learning
          anything at all.
        </p>
      </li>
      <li class="stance__card reveal">
        <h3>Hands on, and unafraid</h3>
        <p class="muted">
          Running code beside the code that produced it, editable, with nothing punishing a bad
          edit. Breaking it isn't the point. Being in it is: changing a number because you
          wondered what it did, and finding out. Things do break, and that is fine; it is the
          evidence you were actually involved rather than watching. Nothing here scores you or
          keeps a streak, so there is nothing to protect, and somebody with nothing to protect is
          still enjoying it an hour later.
        </p>
      </li>
    </ul>

    <p class="framing">
      The first one below isn't a code demo. Mistakes have to be free before anyone writes a line:
      trying again is the expected move, not an admission of defeat. Get that wrong and the
      attempts turn timid, and fear is slow to undo.
    </p>

    <article class="toy" id="two-framings">
      <header class="toy__head">
        <p class="eyebrow">Before the code · Learning science</p>
        <h3>One puzzle, two framings</h3>
        <p class="lede prose">
          Two people get the same puzzle. One is told a wrong guess costs five points; the other is
          just told to try again. Nothing else differs. Play either version, notice how you feel about guessing. The numbers come after.
        </p>
      </header>

      <details class="toy__run" open>
        <summary>
          <span class="toy__run-label">Play both versions</span>
        </summary>
        <div class="toy__body">
          <SuperMarioEffect />
        </div>
      </details>

      <p class="credit">
        The effect this demonstrates is Mark Rober's, named the Super Mario Effect and shown in his
        2018 TEDxPenn talk{' '}
        <a
          href="https://www.ted.com/talks/mark_rober_the_super_mario_effect_tricking_your_brain_into_learning_more"
          rel="noopener">The Super Mario Effect: tricking your brain into learning more</a
        >. The idea, the coding challenge and the numbers in it are his; the toys on this page are
        my own restaging of them for a classroom.
      </p>
    </article>

    <p class="framing">
      Everything below is code, and the rule you just felt is still the one running underneath it.
      Change a number, see what it does, change it back. That loop is the whole method, and these
      are the smallest places I can show it to you.
    </p>

    <article class="toy" id="super-mario-effect">
      <header class="toy__head">
        <p class="eyebrow">Loops, state, a little physics</p>
        <h3>The Super Mario Effect</h3>
        <p class="lede prose">
          Mario doesn't tell you you're a bad person when you fall in a pit. He puts you back at the
          start of the level. Miss this one a few times on purpose, then read the rule beside it and
          notice what isn't in there: the comment that says <code>// no points lost. no lecture.</code>
          is sitting on the only line where a punishment could go. Put <code>world.lose(5)</code> on
          it, or press <em>Punish the miss</em>, and watch the page argue with itself.
        </p>
      </header>
      <details class="toy__run" open>
        <summary>
          <span class="toy__run-label">Play the level</span>
        </summary>
        <div class="toy__body">
          <RespawnGame />
        </div>
      </details>
    </article>

    <article class="toy" id="caesar-cipher">
      <header class="toy__head">
        <p class="eyebrow">Shown, not told</p>
        <h3>A Caesar cipher</h3>
        <p class="lede prose">
          A student can be told that <code>% 26</code> handles the wraparound and write it down
          without ever seeing it. So instead: shift every letter forward, and watch what happens
          when <code>z</code> has to become <code>c</code>. Drag the shift, watch the red cells.
          That is the explanation. The sentence about modulo is just the caption.
        </p>
      </header>
      <details class="toy__run" open>
        <summary>
          <span class="toy__run-label">Try the cipher</span>
        </summary>
        <div class="toy__body">
          <CaesarCipher />
        </div>
      </details>
    </article>
  </section>

  <section class="section ladder-section" id="eight-weeks">
    <div class="page">
      <p class="eyebrow">The shape of a term</p>
      <h2 class="section__title">Eight weeks, one thing, getting harder</h2>
      <p class="lede prose">
        One example term, running the to-do list above: each week the app gains a capability, and
        the student gains the concern that arrives with it. The final assessment is their own app, with real users, not a zip file that only runs on my laptop.
      </p>
      <p class="lede prose ladder__note">
        A different project, a shorter unit, a class that already has a syllabus, or an adult with
        one evening a week all reorder these rungs, and some terms never reach week seven, which is
        fine. What carries over is the shape: one thing, gaining a capability at a time, with the
        student able to explain each one.
      </p>

      <ol class="ladder">
        {
          weeks.map((week) => (
            <li class="rung reveal">
              <span class="rung__w">Week {week.w}</span>
              <span class="rung__t">{week.t}</span>
              <span class="rung__d muted">{week.d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section page" id="assessment">
    <div class="two-up">
      <div>
        <p class="eyebrow">Evidence of judgement</p>
        <h2 class="section__title">The engineering journal</h2>
        <p class="prose muted">
          A significant AI-assisted change gets a few sentences. Not to create paperwork, but to leave a trail showing that a person, not a model, made the call. These five questions are the version I use, kept in commit messages, in a doc, or just said out loud to me, whichever
          one a student will actually keep up.
        </p>
        <ol class="journal">
          {journal.map((q) => <li>{q}</li>)}
        </ol>
      </div>

      <div>
        <p class="eyebrow">Assessment</p>
        <h2 class="section__title">What I actually grade</h2>
        <p class="prose muted">
          Notice what isn't on this list: how much code you produced. In a world where code is cheap,
          grading volume grades the wrong thing. Where a school has its own rubric, these map onto it
          rather than replace it, and where nobody is being graded at all, it is simply the list of
          things we work on.
        </p>
        <ul class="graded">
          {graded.map((g) => <li>{g}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section page" id="fit">
    <p class="eyebrow">Fit</p>
    <h2 class="section__title">You already have constraints</h2>
    <p class="lede prose">
      A class you did not pick, a syllabus you are committed to, a schedule with holes in it, a
      student who only wants to build one specific thing. None of those are obstacles to this. They are the inputs. The page above settles each of these on one setting so it could say
      something concrete; here is the range each one actually has.
    </p>

    <dl class="fits">
      {
        fits.map((f) => (
          <div class="fit reveal">
            <dt>{f.label}</dt>
            <dd class="muted">{f.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ContactCTA
    heading="Ready to see it up close?"
    body="Tell me the constraints you actually have: the student, the class, the schedule, the syllabus you're already committed to. Then I'll tell you how I'd run it inside them. If what you want isn't on this page, describe it anyway."
  />
</BaseLayout>

<style>
  .lead-grid {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 60rem) {
    .lead-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .callout {
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent-bright);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    padding: var(--s-5);
    box-shadow: var(--shadow-sm);
  }

  .callout__big {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-block: var(--s-3);
  }

  .section__title {
    margin-block: var(--s-3) var(--s-4);
  }

  /* ---- ladder ---- */

  .ladder-section {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }

  .ladder {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: 2px;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .rung {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-5);
    background: var(--bg-raised);
    transition: background var(--dur) var(--ease);
  }

  .rung:hover {
    background: var(--accent-soft);
  }

  @media (min-width: 48rem) {
    .rung {
      grid-template-columns: 6rem minmax(0, 14rem) minmax(0, 1fr);
      gap: var(--s-5);
      align-items: baseline;
    }
  }

  .rung__w {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-weight: 700;
  }

  .rung__t {
    font-weight: 700;
  }

  .rung__d {
    font-size: var(--t-sm);
  }

  /* The ladder is one example term, so the note that says so sits directly under
     the lede rather than after the rungs;
     by then a reader has already taken the
     eight weeks as a fixed syllabus. */
  .ladder__note {
    margin-top: var(--s-4);
    font-size: var(--t-base);
    color: var(--text-muted);
  }

  /* ---- fits ---- */

  .fits {
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .fit {
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-bright);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .fit dt {
    font-family: var(--f-display);
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--s-3);
  }

  .fit dd {
    margin: 0;
    font-size: var(--t-sm);
  }

  /* ---- two-up ---- */

  .two-up {
    display: grid;
    gap: var(--s-8);
  }

  @media (min-width: 56rem) {
    .two-up {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .journal,
  .graded {
    margin-top: var(--s-5);
    padding-left: 0;
    list-style: none;
  }

  .journal {
    counter-reset: j;
  }

  .journal li {
    counter-increment: j;
    position: relative;
    padding: var(--s-3) 0 var(--s-3) var(--s-6);
    border-bottom: 1px solid var(--border);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
  }

  .journal li::before {
    content: counter(j);
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .graded li {
    position: relative;
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    font-size: var(--t-sm);
  }

  .graded li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-weight: 700;
  }

  /* ---- cta ---- */

  /* ---- the two stance principles, and the toys that evidence them ---- */

  .stance {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 var(--s-8);
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .stance__card {
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }


  .stance__card h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-3);
  }

  /* Connective narration at section level, not inside a toy: it frames the Mario
     piece as a teaching demonstration rather than a code demo, then hands off to
     the code toys. Body size and muted on purpose:
     the toy ledes below it
     should stay the loudest thing in each block. */
  .framing {
    max-width: var(--measure);
    margin-bottom: var(--s-8);
    color: var(--text-muted);
  }

  /* No `scroll-margin-top`: it used to clear the site nav for the toys' own
     anchors, but `scroll-padding-top` on the root now clears both sticky bars
     for every anchor on the page, and the two would stack into 6rem of dead
     space above a linked toy. */
  .toy {
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-8);
    border-bottom: 1px solid var(--border);
  }

  .toy:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .toy__head h3 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }

  /* Attribution, not body copy:
     it sits under the game it credits, close
     enough to belong to it but quiet enough not to read as the next lesson.

     Not `var(--measure)`: that is 68ch, and `ch` resolves against the element's
     own font-size, so at --t-sm this paragraph wrapped roughly 1.4x narrower
     than the --t-lg lede above it and left a ragged short column. A rem measure
     is font-size independent, so both wrap on the same right edge. */
  .credit {
    max-width: 47rem;
    margin-top: var(--s-5);
    margin-inline: auto;
    text-align: center;
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  /*
   * The three toys are the best evidence on this page and also the bulk of it:
   * their interactive bodies alone ran to ~1,900px, which is why the section
   * was two-fifths of a twelve-screen page. Collapsing the *body* rather than
   * the whole toy is the trade that keeps both:
   * every title, eyebrow and lede
   * stays on the page, so a scroller still meets all three and can see what
   * each one offers; only the running app waits to be asked for.
   *
   * `<details>` rather than a scripted accordion: it is the browser's own
   * widget, so it works with JavaScript off, is keyboard operable and announced
   * as expandable for free, and Ctrl+F still finds text inside a closed one in
   * current browsers. The first is `open` because the section's lede promises
   * "it runs, you can edit it";
   * a reader should meet a running thing without
   * having to ask for it first, and the two below it are then clearly the
   * optional deeper cuts.
   */
  .toy__run > summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: fit-content;
    margin-top: var(--s-5);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--bg-raised);
    cursor: pointer;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--text-muted);
    /* Removes the default disclosure triangle so the chevron below can carry
       the state; `display` above already suppresses it in most engines, and
       this covers Safari, which uses a pseudo-element instead. */
    list-style: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toy__run > summary::-webkit-details-marker {
    display: none;
  }

  .toy__run > summary:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .toy__run > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The chevron: a rotating caret drawn from a border, so it needs no asset and
     inherits the summary's own color through `currentColor`. */
  .toy__run > summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    /* Points down when closed, up when open. The -0.15em nudges the glyph onto
       the text's optical center rather than its box center. */
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform 0.15s ease;
  }

  .toy__run[open] > summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }

  .toy__run[open] > summary {
    color: var(--text);
  }

