---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EngineeringLoop from '../components/EngineeringLoop.astro';
import { navItems, siteMeta, careerYears } from '../data/nav';
import teaching from '../assets/original/teaching-se-asia.jpg';
import office from '../assets/office-alchemy-2022.jpg';
import avatar from '../assets/jacob-hite-avatar.jpg';

const facts = [
  { value: '1999', label: 'BS Computer Science, CU Boulder' },
  { value: `${careerYears} yrs`, label: 'shipping software for a living' },
  { value: '2011', label: 'moved to South East Asia' },
  { value: 'CELTA', label: 'certified in Chiang Mai, 2011' },
  { value: '2026', label: 'switch from software engineering to teaching about it' },
];

const offerings = [
  {
    kicker: 'For students',
    title: 'Computer science, grades 9–12',
    body: 'One real application, built from nothing across a term, ideally one the student picks. Concepts arrive when the app needs them, and the plan bends to the class, the school\'s curriculum, and the kid in front of me.',
    href: '/teaching',
  },
  {
    kicker: 'For career changers',
    title: 'Programming for adults',
    body: 'Beginners and working professionals alike. Bring the thing you want to exist and whatever time you actually have, whether that is an evening a week or a run of Saturdays, and we build the pace around it.',
    href: '/teaching',
  },
  {
    kicker: 'For engineers and engineering managers',
    title: 'System design, interviews, mentoring',
    body: 'Mock interviews with real pressure, system design that survives follow-up questions, and mentoring through the jump to leadership. Take one, or mix all three around whatever is actually coming up.',
    href: '/coaching',
  },
];
---

<BaseLayout
  title="Jacob Hite"
  description="Former Amazon and Google software engineer turned software engineering teacher and coach. I teach software engineering to grades 9–12 and to professionals, and I mentor engineers and engineering managers through system design, mock interviews, and the jump to leadership."
>
  <section class="hero">
    <div class="page hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Engineer → Teacher</p>
        <h1>
          {careerYears} years building software.<br />
          Now I teach it, for the <mark>AI</mark> era.
        </h1>
        <p class="lede">
          Computer science for grades 9–12 and for professionals. Teaching, system design,
          mock interviews, and mentoring engineers and engineering managers.
        </p>
        <div class="hero__byline">
          <Image
            class="hero__face"
            src={avatar}
            alt={`${siteMeta.name}, mid-laugh, turned slightly away from the camera.`}
            widths={[80, 160]}
            sizes="80px"
            loading="eager"
          />
          <p class="hero__tagline">{siteMeta.tagline}</p>
        </div>

        <div class="hero__cta">
          <a class="btn btn--primary" href="/teaching">How I teach</a>
          <a class="btn" href="/teaching#hands-on">Try a lesson →</a>
          {
            siteMeta.email && (
              <a class="btn btn--mail" href={`mailto:${siteMeta.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" stroke="currentColor" stroke-width="1.8" />
                  <path d="m3.5 6.5 8.5 6.5 8.5-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                {siteMeta.email}
              </a>
            )
          }
        </div>
      </div>

      {/* The two halves of the sentence in the headline, in order: the desk the
          career happened at, then the room it is turning into. */}
      <div class="hero__figures">
        <figure class="hero__figure hero__figure--tilt-left">
          <Image
            src={office}
            alt="Jacob Hite in an open-plan engineering office, rows of desks and monitors behind him and birthday balloons hanging from the ceiling."
            widths={[420, 800, 1200]}
            sizes="(min-width: 60rem) 32rem, 92vw"
            loading="eager"
          />
          <figcaption>Alchemy, 2022.</figcaption>
        </figure>

        <figure class="hero__figure">
          <Image
            src={teaching}
            alt="A room of children seated on the floor of a wooden schoolhouse in South East Asia, with two adults teaching at the front."
            widths={[420, 800, 1200]}
            sizes="(min-width: 60rem) 32rem, 92vw"
            loading="eager"
          />
          <figcaption>Volunteer teaching, South East Asia.</figcaption>
        </figure>
      </div>
    </div>

    <div class="page">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="fact">
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section page">
    <p class="eyebrow">What I do</p>
    <h2 class="section__title">Three rooms, one idea</h2>
    <p class="lede prose">
      Whichever room I'm in, the job is the same: get you from "I have no idea how this works" to
      "I built that, and I can tell you why it works." What that takes is different every
      time, so the structure below is a starting point, not a package.
    </p>

    <ul class="offerings">
      {
        offerings.map((o) => (
          <li class="offering reveal">
            <a href={o.href}>
              <p class="offering__kicker">{o.kicker}</p>
              <h3>{o.title}</h3>
              <p class="muted">{o.body}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section loop-section">
    <div class="page">
      <p class="eyebrow">The method</p>
      <h2 class="section__title">AI can write the code. It cannot own the decision.</h2>
      <p class="lede prose">
        So we don't teach students to "code with AI." We teach them to direct, inspect, test,
        and improve software that AI helped produce, whether that is Claude, ChatGPT or an agent
        inside Replit. This is the loop a project settles into. Click a stage. How much of it somebody touches in week one is a separate question; it grows with
        them.
      </p>

      <div class="loop-wrap reveal">
        <EngineeringLoop />
      </div>
    </div>
  </section>

  <section class="section page">
    <blockquote class="pull">
      <p>
        AI can write the code. The person shipping it still owns the specification, the
        verification, the explanation, and the decision to release.
      </p>
      <footer>The through-line, whatever we build</footer>
    </blockquote>
  </section>

  <section class="section page">
    <p class="eyebrow">Everything else</p>
    <h2 class="section__title">Have a look around</h2>
    <ul class="cards">
      {
        navItems.map((item) => (
          <li class="card reveal">
            <a href={item.href}>
              <h3>{item.label}</h3>
              <p class="muted">{item.blurb}</p>
              <span class="card__go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---- hero ---- */

  /* The one-line "who is this": the credential the rest of the page assumes
     you already have. It was only in the footer. The face rides alongside it as
     a byline: the hero photo shows the work, this shows who is doing it. Kept
     small on purpose, so it complements the teaching shot instead of competing. */
  .hero__byline {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .hero__face {
    flex: none;
    width: 5rem;
    height: 5rem;
    border-radius: var(--r-full);
    object-fit: cover;
    border: 2px solid var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .hero__tagline {
    padding-left: var(--s-4);
    border-left: 3px solid var(--accent-bright);
    font-family: var(--f-display);
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }

  .hero {
    padding-block: clamp(2.5rem, 8vw, 6rem) 0;
    background:
      radial-gradient(58rem 30rem at 6% -14%, var(--accent-soft), transparent 62%),
      radial-gradient(46rem 28rem at 100% 0%, var(--accent-2-soft), transparent 66%);
  }

  .hero__grid {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s-7);
    }
  }

  .hero__text > * + * {
    margin-top: var(--s-5);
  }

  /* The hero column is roughly half the page, so the global h1 size is too big here. */
  .hero h1 {
    font-size: clamp(2.4rem, 1.5rem + 3.1vw, 4rem);
  }

  .hero h1 mark {
    background: none;
    color: inherit;
    position: relative;
    white-space: nowrap;
  }

  /* The highlighter stroke under "actually" */
  .hero h1 mark::after {
    content: '';
    position: absolute;
    left: -0.06em;
    right: -0.06em;
    bottom: 0.12em;
    height: 0.26em;
    background: var(--accent-bright);
    opacity: 0.5;
    border-radius: 0.2em;
    z-index: -1;
    transform: rotate(-0.6deg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .btn {
    display: inline-block;
    padding: 0.72em 1.35em;
    border-radius: var(--r-full);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn--primary {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: var(--btn-bg);
  }

  .btn--primary:hover {
    color: var(--btn-fg);
  }

  .btn--mail {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: var(--t-sm);
  }

  .btn--mail svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .hero__figures {
    display: grid;
    gap: var(--s-6);
  }

  .hero__figure {
    margin: 0;
  }

  .hero__figure img {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    transform: rotate(1.1deg);
  }

  /* Tilted against each other, so the pair reads as two prints set down next to
     each other rather than as a grid that failed to line up. */
  .hero__figure--tilt-left img {
    transform: rotate(-1deg);
  }

  .hero__figure figcaption {
    margin-top: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
    text-align: center;
  }

  /* ---- facts ---- */

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--s-4);
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .fact dt {
    font-family: var(--f-display);
    font-size: var(--t-2xl);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--accent);
    line-height: 1;
  }

  .fact dd {
    margin: var(--s-2) 0 0;
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  /* ---- sections ---- */

  .section__title {
    margin-block: var(--s-3) var(--s-4);
  }

  .offerings,
  .cards {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    gap: var(--s-4);
  }

  .offerings {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  /* Seven cards over four columns leaves an orphan row of three. An auto-fit grid
     pins that row to the left, so it reads as a mistake. Flex with a fixed basis
     keeps every card the same width and centers whatever the last row holds. */
  .cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* 16.5rem is exactly a quarter of the widest content row: (1200px page - 2x3rem
     padding - 3x1rem gap) / 4 = 264px. Four fill the row edge to edge, so the top
     row still lines up with the section heading, and nothing grows: every card
     stays the same width, which is what lets the short row center under them. */
  .cards > li {
    flex: 0 1 min(100%, 16.5rem);
  }

  .offering a,
  .card a {
    display: block;
    height: 100%;
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .offering a:hover,
  .card a:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-bright);
  }

  .offering__kicker {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-weight: 700;
    margin-bottom: var(--s-3);
  }

  .offering h3,
  .card h3 {
    margin-bottom: var(--s-3);
  }

  .card__go {
    display: inline-block;
    margin-top: var(--s-3);
    color: var(--accent);
    font-weight: 700;
    transition: transform var(--dur) var(--ease);
  }

  .card a:hover .card__go {
    transform: translateX(4px);
  }

  /* ---- loop ---- */

  .loop-section {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }

  .loop-wrap {
    margin-top: var(--s-7);
  }

  /* ---- pull quote ---- */

  .pull {
    margin: 0;
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .pull p {
    font-family: var(--f-display);
    font-size: var(--t-2xl);
    font-weight: 600;
    font-style: italic;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pull footer {
    margin-top: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
