---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import MerrillCycle from '../../components/MerrillCycle.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, status, group, sourcePath, diagram } = entry.data;
---

<BaseLayout
  title={title}
  description={subtitle ?? `${title} — from my Moreland University TEACH-NOW e-portfolio.`}
>
  <PageHeader eyebrow={group} title={title} lede={subtitle} />

  <article class="section page">
    <div class="meta">
      <StatusPill status={status} />
      <span class="meta__source muted">
        Originally at <code>{sourcePath}</code> on the Moreland site
      </span>
    </div>

    {
      status === 'placeholder' ? (
        <div class="placeholder prose">
          <p class="placeholder__mark" aria-hidden="true">
            ✎
          </p>
          <h2>Nothing written here yet</h2>
          <p>
            This page was a bare heading on the original site, and it is a bare heading here. It is
            carried over so the shape of the portfolio stays honest — when the module gets written
            up, the words land here.
          </p>
        </div>
      ) : (
        <>
          {/* Outside `.prose` on purpose: the diagram is wider than the reading
              measure, and centered on the page rather than on the column. */}
          {diagram === 'merrill-cycle' && (
            <div class="diagram">
              <MerrillCycle />
            </div>
          )}
          <div class="prose">
            <Content />
          </div>
        </>
      )
    }

    <nav class="pager" aria-label="Portfolio pages">
      {
        prev ? (
          <a class="pager__link pager__link--prev" href={`/portfolio/${prev.id}`}>
            <span class="pager__dir">← Previous</span>
            <span class="pager__title">{prev.data.navLabel}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager__link pager__link--next" href={`/portfolio/${next.id}`}>
            <span class="pager__dir">Next →</span>
            <span class="pager__title">{next.data.navLabel}</span>
          </a>
        )
      }
    </nav>

    <p class="back"><a href="/portfolio">All portfolio pages</a></p>
  </article>

  <ImageLightbox />
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
    font-size: var(--t-sm);
  }

  .placeholder {
    border: 2px dashed var(--border-strong);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 5vw, 3rem);
    background: var(--bg-sunken);
    text-align: center;
    margin-inline: auto;
  }

  .placeholder__mark {
    font-size: 2.5rem;
    line-height: 1;
    color: var(--text-faint);
  }

  .placeholder h2 {
    font-size: var(--t-xl);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent-bright);
    background: var(--accent-soft);
    padding: var(--s-4);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    font-size: var(--t-sm);
  }

  .prose :global(blockquote p + p) {
    margin-top: var(--s-3);
  }

  /* Diagrams come with a white background baked in, so give them a paper card
     to sit on rather than letting them glare out of a dark page. */
  .diagram {
    display: flex;
    justify-content: center;
    margin-bottom: var(--s-7);
  }

  /* `:has(img)`, not `:has(> img)` — the lightbox wraps each image in a button,
     so it stops being a direct child once the script has run. */
  .prose :global(p:has(img)) {
    margin-inline: auto;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-sm);
  }

  .prose :global(ul) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: var(--s-2);
  }

  /* A tabbed page needs the full width for its rail-and-panel grid, but the
     lede above the tabs is still prose and still wants the reading measure. So
     the constraint moves off the column and onto the children that are text.
     The panels re-apply it to themselves. */
  .prose:has(.tabs) {
    max-width: none;
  }

  .prose:has(.tabs) > :global(:not(.tabs)) {
    max-width: var(--measure);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .pager__link {
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
    max-width: 45%;
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }

  .pager__dir {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  .pager__title {
    font-weight: 700;
  }

  .pager__link:hover .pager__title {
    color: var(--accent);
  }

  .back {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
  }
</style>
