---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SuperMarioEffect from '../components/SuperMarioEffect.astro';
import RespawnScene from '../components/RespawnScene.astro';
import CaesarCipher from '../components/CaesarCipher.astro';
import WordCounter from '../components/WordCounter.astro';
---

<BaseLayout
  title="Playground"
  description="Live, playable versions of the lessons I teach: the Super Mario Effect, a Caesar cipher, and an object used as a word counter."
>
  <PageHeader
    eyebrow="Playground"
    title="Things you can break"
    lede="Working versions of lessons my students build. Nothing here is a video of someone else doing it — put your hands on the controls."
  />

  <section class="section page">
    <article class="toy" id="super-mario-effect">
      <header class="toy__head">
        <p class="eyebrow">Before the code · Learning science</p>
        <h2>The Super Mario Effect</h2>
        <p class="lede prose">
          Mario doesn't tell you you're a bad person when you fall in a pit. He puts you back at the
          start of the level. Here's the same puzzle under two different framings — pick one, play
          it, and notice how you feel about guessing.
        </p>
        <RespawnScene />
      </header>
      <div class="toy__body">
        <SuperMarioEffect />
      </div>
    </article>

    <article class="toy" id="caesar-cipher">
      <header class="toy__head">
        <p class="eyebrow">Lesson 02 · Strings, loops, functions</p>
        <h2>A Caesar cipher</h2>
        <p class="lede prose">
          Shift every letter forward. Easy — until <code>z</code> needs to become <code>c</code>.
          Drag the shift and watch the red cells: that's the wraparound, and that's what
          <code>% 26</code> is for.
        </p>
      </header>
      <div class="toy__body">
        <CaesarCipher />
      </div>
    </article>

    <article class="toy" id="word-counter">
      <header class="toy__head">
        <p class="eyebrow">Lesson 04 · Objects</p>
        <h2>An object as a counter</h2>
        <p class="lede prose">
          An array stores values by position. An object stores them by key — which makes it a
          tally sheet. Paste anything in and watch the keys appear.
        </p>
      </header>
      <div class="toy__body">
        <WordCounter />
      </div>
    </article>
  </section>

  <section class="section page">
    <div class="more">
      <h2>More is coming</h2>
      <p class="muted">
        The full lesson sequence — variables and input, the cipher, arrays and data summaries,
        objects and word counting — each has a working version, practice set, homework, and tests
        behind it. They land here as I convert them.
      </p>
      <p class="muted">
        Next up: a systems-design sandbox where you place components and I break them on purpose.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .toy {
    scroll-margin-top: 6rem;
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-8);
    border-bottom: 1px solid var(--border);
  }

  .toy:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .toy__head :global(.respawn) {
    margin-top: var(--s-5);
    max-width: 34rem;
  }

  .toy__head h2 {
    font-size: var(--t-2xl);
    margin-block: var(--s-2) var(--s-4);
  }

  .toy__body {
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .more {
    max-width: var(--measure);
    padding: var(--s-6);
    border: 2px dashed var(--border-strong);
    border-radius: var(--r-lg);
  }

  .more h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--s-3);
  }

  .more p + p {
    margin-top: var(--s-3);
  }
</style>
