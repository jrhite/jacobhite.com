---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { navItems } from '../data/nav';
---

{/* Without a 404.html, Cloudflare Pages answers every unknown path with the
    home page and a 200, which search engines index as duplicate content. */}
<BaseLayout title="Page not found" description="That page does not exist on jacobhite.com." noindex>
  <PageHeader
    eyebrow="404"
    title="Nothing lives at this address"
    lede="The link may be old, or mistyped. One of these is probably what you were after."
  />

  <section class="section page">
    <ul class="links">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding: 0;
    list-style: none;
    font-weight: 700;
  }
</style>
