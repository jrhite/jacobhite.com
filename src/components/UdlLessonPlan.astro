  }

  .udl__mods {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
    display: grid;
    gap: var(--s-3);
  }

  .udl__mod {
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
  }

  .udl__mod[hidden] {
    display: none;
  }

  .udl__mod-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }

  .udl__who {
    font-weight: 700;
    margin-right: var(--s-1);
  }

  .udl__change {
    margin-top: var(--s-2);
  }

  .udl__change :global(ul) {
    margin: 0;
  }

  .udl__why {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
  }

  .udl__why summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
    width: fit-content;
  }

  .udl__why p {
    margin-top: var(--s-2);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  @media (max-width: 34rem) {
    .udl__plan div {
      grid-template-columns: 1fr;
    }

    .udl__mod {
      padding: var(--s-4);
    }
  }
</style>

<script>
  /**
   * Shows one student's modifications at a time. A step with nothing left
   * for that student hides too, so the filtered view is a short list rather
   * than a run of original-plan boxes with nothing under them.
   */
  for (const root of document.querySelectorAll<HTMLElement>('[data-udl-plan]')) {
    const bar = root.querySelector<HTMLElement>('[data-udl-filter]');
    if (!bar) continue;
    const chips = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-udl-step]')];

    const apply = (who: string) => {
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.filter === who));
      for (const step of steps) {
        let shown = 0;
        for (const mod of step.querySelectorAll<HTMLElement>('[data-student]')) {
          const match = who === 'all' || mod.dataset.student === who;
          mod.hidden = !match;
          if (match) shown++;
        }
        step.hidden = shown === 0;
      }
    };

    for (const c of chips) c.addEventListener('click', () => apply(c.dataset.filter ?? 'all'));
    bar.hidden = false;
  }
</script>
