---
/**
 * Merrill's first principles, drawn rather than photographed.
 *
 * This replaces a flat JPG export. A raster diagram has one background baked
 * into it, so it can only ever suit one theme, and its labels shrink with the
 * image until they're unreadable on a phone. Built from real elements instead,
 * it takes the theme's own tokens, the text stays text — selectable, findable,
 * and sized by the reader's own settings — and the layout reflows to one
 * column rather than demanding a pinch and a squint.
 *
 * Node labels are paragraphs, not headings: they name parts of a diagram rather
 * than sections of the page, and as headings they put a second copy of all five
 * principle names into the document outline directly below the cards that
 * explain them.
 *
 * A name is all each cell carries. The cards above already say what each
 * principle looks like in a lesson, in full; a one-line gloss in the diagram
 * could only paraphrase them. What the cards cannot say is that the four run as
 * a loop around a single task, and that is the whole job left for the drawing.
 *
 * DOM order is the single-column reading order: hub, then the four principles
 * in the order they run. The wide layout is placed with grid areas rather than
 * source order, so the reflow needs no reordering and the markup stays the
 * thing a screen reader would want to hear.
 *
 * The arrows are CSS rules and borders, not artwork: they stretch to whatever
 * cell they land in, so nothing distorts as the grid reflows, and each one is
 * pointed by the layout rather than baked facing one way.
 */

const cycle = [
  { key: 'a', name: 'Activation' },
  { key: 'b', name: 'Demonstration' },
  { key: 'c', name: 'Application' },
  { key: 'd', name: 'Integration' },
];

const lesson = [
  { step: 'Warm-up', maps: 'activation' },
  { step: 'Live demo', maps: 'demonstration' },
  { step: 'You build', maps: 'application' },
  { step: 'Reflect', maps: 'integration' },
];
---

<figure class="mc">
  <p class="mc__title">How the four cycle around the one task</p>

  <div class="mc__grid">
    <div class="mc__hub">
      <p class="mc__name">Task-centered</p>
    </div>

    {
      cycle.map((c, i) => (
        <>
          <div class={`mc__node mc__node--${c.key}`}>
            <p class="mc__name">{c.name}</p>
          </div>
          <span
            class={`mc__arrow mc__arrow--${c.key}${cycle[(i + 1) % cycle.length].key}`}
            aria-hidden="true"
          />
        </>
      ))
    }
  </div>

  <div class="mc__lesson">
    <p class="mc__lesson-title">A 50-minute lesson usually runs this cycle</p>
    <ol class="mc__steps">
      {
        lesson.map((s) => (
          <li>
            <span class="mc__step">{s.step}</span>
            <span class="mc__maps">{s.maps}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption>
    One real application at the center, and lessons run the loop around it:
    integration feeds the next activation.
  </figcaption>
</figure>

<style>
  .mc {
    margin: 0 auto;
    width: 100%;
    max-width: 54rem;
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .mc__title {
    margin: 0 0 var(--s-5);
    text-align: center;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--t-lg);
  }

  /* Corners hold the four principles and the middle cell the thing they orbit;
     the cells between them are arrows, which is why they scale with the grid. */
  .mc__grid {
    display: grid;
    gap: var(--s-3);
    /* The middle column carries the hub as well as the horizontal arrows, so it
       needs room for the widest hub word rather than just for an arrowhead. */
    grid-template-columns: 1fr minmax(9rem, 0.62fr) 1fr;
    grid-template-areas:
      'a  ab  b'
      'da hub bc'
      'd  cd  c';
  }

  .mc__hub {
    grid-area: hub;
  }
  .mc__node--a {
    grid-area: a;
  }
  .mc__node--b {
    grid-area: b;
  }
  .mc__node--c {
    grid-area: c;
  }
  .mc__node--d {
    grid-area: d;
  }
  .mc__arrow--ab {
    grid-area: ab;
  }
  .mc__arrow--bc {
    grid-area: bc;
  }
  .mc__arrow--cd {
    grid-area: cd;
  }
  .mc__arrow--da {
    grid-area: da;
  }

  .mc__node,
  .mc__hub {
    padding: var(--s-4);
    border-radius: var(--r-md);
    text-align: center;
    min-width: 0;
  }

  .mc__node {
    border: 1px solid color-mix(in oklab, var(--accent-2) 35%, transparent);
    background: var(--accent-2-soft);
  }

  .mc__hub {
    border: 2px dashed color-mix(in oklab, var(--accent) 45%, transparent);
    background: var(--accent-soft);
  }

  .mc__node .mc__name,
  .mc__hub .mc__name {
    margin: 0;
    font-size: var(--t-base);
    font-weight: 700;
  }

  .mc__node .mc__name {
    color: var(--accent-2);
  }

  .mc__hub .mc__name {
    color: var(--accent);
  }

  /* Arrows: a rule plus a border triangle. No artwork to distort. */
  .mc__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--border-strong);
  }

  .mc__arrow::before {
    content: '';
    background: currentColor;
  }

  .mc__arrow::after {
    content: '';
    border: 6px solid transparent;
  }

  /* Horizontal pair: ab points right along the top, cd points left along the
     bottom, so the cycle reads clockwise. */
  .mc__arrow--ab,
  .mc__arrow--cd {
    flex-direction: row;
  }

  .mc__arrow--cd {
    flex-direction: row-reverse;
  }

  .mc__arrow--ab::before,
  .mc__arrow--cd::before {
    flex: 1;
    height: 2px;
  }

  .mc__arrow--ab::after {
    border-left-color: currentColor;
    border-right-width: 0;
  }

  .mc__arrow--cd::after {
    border-right-color: currentColor;
    border-left-width: 0;
  }

  /* Vertical pair: bc down the right, da back up the left. */
  .mc__arrow--bc,
  .mc__arrow--da {
    flex-direction: column;
  }

  .mc__arrow--da {
    flex-direction: column-reverse;
  }

  .mc__arrow--bc::before,
  .mc__arrow--da::before {
    flex: 1;
    width: 2px;
  }

  .mc__arrow--bc::after {
    border-top-color: currentColor;
    border-bottom-width: 0;
  }

  .mc__arrow--da::after {
    border-bottom-color: currentColor;
    border-top-width: 0;
  }

  /* ---- the lesson strip ---- */

  .mc__lesson {
    margin-top: var(--s-5);
    padding: var(--s-4);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
  }

  .mc__lesson-title {
    margin: 0 0 var(--s-3);
    text-align: center;
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .mc__steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mc__steps li {
    flex: 1 1 8rem;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--bg-sunken);
    text-align: center;
  }

  .mc__step {
    font-weight: 700;
    font-size: var(--t-sm);
  }

  .mc__maps {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  .mc figcaption {
    margin-top: var(--s-4);
    text-align: center;
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  /* One column, one direction of travel. Source order already reads correctly,
     so the areas are simply dropped. The three arrows between the principles
     turn to point down; `da` closes the loop back to the top, which a straight
     line can't say once the layout is linear, so the caption carries it. */
  @media (max-width: 44rem) {
    .mc__grid {
      grid-template-columns: 1fr;
      grid-template-areas: none;
    }

    .mc__hub,
    .mc__node--a,
    .mc__node--b,
    .mc__node--c,
    .mc__node--d,
    .mc__arrow--ab,
    .mc__arrow--bc,
    .mc__arrow--cd,
    .mc__arrow--da {
      grid-area: auto;
    }

    .mc__arrow--da {
      display: none;
    }

    .mc__arrow--ab,
    .mc__arrow--bc,
    .mc__arrow--cd {
      flex-direction: column;
      min-height: 1.75rem;
    }

    .mc__arrow--ab::before,
    .mc__arrow--bc::before,
    .mc__arrow--cd::before {
      flex: 1;
      width: 2px;
      height: auto;
    }

    .mc__arrow--ab::after,
    .mc__arrow--cd::after {
      border: 6px solid transparent;
      border-top-color: currentColor;
      border-bottom-width: 0;
    }
  }
</style>
