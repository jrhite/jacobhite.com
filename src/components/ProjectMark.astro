---
/**
 * A product's own brand mark, at a given size.
 *
 * - owlabee: the mark from owlabee/owlabee tools/brand/render.mjs (two
 *   honeycomb-cell eyes, gold monocle and chain, honey-drop beak), drawn
 *   inline so its lines take `currentColor`. Inside `.brand-owlabee` that is
 *   Charcoal on Cream, or Cream on Charcoal in dark mode, which is exactly
 *   the kit's full-color and reversed pair. The gold is the kit's Gold.
 * - owlonit: the avatar from owlonit/owlonit marketing/branding, which
 *   carries its own dark badge and reads on either ground.
 */
import { Image } from 'astro:assets';
import owlonitAvatar from '../assets/brands/owlonit.svg';

interface Props {
  id: 'owlonit' | 'owlabee';
  size: number;
}

const { id, size } = Astro.props;
---

{
  id === 'owlabee' ? (
    <svg
      class="project-mark project-mark--owlabee"
      viewBox="0 0 100 100"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <g transform="translate(0,2)">
        <g fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round">
          <polygon points="30.95,24 50,35 50,57 30.95,68 11.9,57 11.9,35" />
          <polygon points="69.05,24 88.1,35 88.1,57 69.05,68 50,57 50,35" />
        </g>
        <circle cx="30.95" cy="45" r="7" fill="currentColor" />
        <circle cx="69.05" cy="45" r="7" fill="currentColor" />
        <circle cx="69.05" cy="45" r="13.5" fill="none" stroke="var(--owlabee-gold)" stroke-width="3" />
        <path d="M78.6,54.6 C83,62 88,71 84,83" fill="none" stroke="var(--owlabee-gold)" stroke-width="1.6" stroke-linecap="round" />
        <polygon points="45,64.5 55,64.5 50,73" fill="var(--owlabee-gold)" />
      </g>
    </svg>
  ) : (
    <Image class="project-mark" src={owlonitAvatar} alt="" width={size} height={size} />
  )
}
