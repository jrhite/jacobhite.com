---
/**
 * A product's own avatar, at a given size. Both are the products' official
 * profile images, redrawn from their brand kits' vector sources so they stay
 * sharp at any size:
 *
 * - owlabee: the kit's avatar (owlabee/owlabee tools/brand/render.mjs,
 *   `avatar-cream-1024`): the monocle mark inside a Gold ring on a Cream disc.
 *   Lines take `currentColor` and the disc takes the brand ground, and the
 *   ring token is transparent in dark mode, so in dark mode it becomes the
 *   kit's `avatar-charcoal`: a cream mark on Charcoal with no ring.
 * - owlonit: the app icon (owlonit/owlonit design/branding/src/
 *   owl-icon-square.svg), the full owl with its monocle on the stone tile,
 *   with the corner rounding an app icon gets on a phone.
 */
import { Image } from 'astro:assets';
import owlonitIcon from '../assets/brands/owlonit-icon.svg';

interface Props {
  id: 'owlonit' | 'owlabee';
  size: number;
}

const { id, size } = Astro.props;
---

{
  id === 'owlabee' ? (
    <svg
      class="project-mark project-mark--owlabee"
      viewBox="0 0 100 100"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="50" cy="50" r="49" fill="var(--owlabee-ground)" />
      <circle cx="50" cy="50" r="43.2" fill="none" stroke="var(--owlabee-avatar-ring)" stroke-width="1.6" />
      <g transform="translate(18.75 18.75) scale(0.625)">
        <g transform="translate(0,2)">
          <g fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round">
            <polygon points="30.95,24 50,35 50,57 30.95,68 11.9,57 11.9,35" />
            <polygon points="69.05,24 88.1,35 88.1,57 69.05,68 50,57 50,35" />
          </g>
          <circle cx="30.95" cy="45" r="7.5" fill="currentColor" />
          <circle cx="69.05" cy="45" r="7.5" fill="currentColor" />
          <circle cx="69.05" cy="45" r="13.5" fill="none" stroke="var(--owlabee-gold)" stroke-width="3.4" />
          <polygon points="45,64.5 55,64.5 50,73" fill="var(--owlabee-gold)" />
        </g>
      </g>
    </svg>
  ) : (
    <Image class="project-mark project-mark--owlonit" src={owlonitIcon} alt="" width={size} height={size} />
  )
}

<style>
  .project-mark--owlonit {
    border-radius: 22%;
    box-shadow: var(--shadow-sm);
  }
</style>
