---
/**
 * A slide deck rendered as elements rather than embedded as a file.
 *
 * The alternative was a picture of each slide. That carries one background and
 * shrinks its own labels, so it suits exactly one theme and one screen width —
 * the reason the diagrams here are built rather than exported. Built from the
 * deck's own content it takes the page tokens, reflows on a phone, and its text
 * can be selected, searched, translated and read aloud. The original file stays
 * downloadable next to it for anyone who wants the real thing.
 *
 * Degrades the way the tabs do: with no JavaScript every slide is stacked and
 * numbered, which is also what prints. The script adds the one-at-a-time view.
 */
import type { Slide } from '../data/promoting-literacy-slides';

interface Props {
  slides: Slide[];
  /** Names the deck for a screen reader meeting it out of context. */
  label: string;
}

const { slides, label } = Astro.props;
---

<figure class="deck" data-slide-deck aria-label={label}>
  <div class="deck__bar">
    <span class="deck__label">Slides</span>
    <span class="deck__count" data-deck-count>{slides.length} slides</span>
  </div>

  <div class="deck__stage">
    {
      slides.map((slide, i) => (
        <article class="slide" data-slide aria-label={`Slide ${i + 1} of ${slides.length}`}>
          <p class="slide__num" aria-hidden="true">
            {i + 1}
          </p>
          {slide.kicker && <p class="slide__kicker">{slide.kicker}</p>}
          <h4 class="slide__title">{slide.title}</h4>
          {slide.lede && <p class="slide__lede">{slide.lede}</p>}

          {slide.stats && (
            <div class="slide__stats">
              {slide.stats.map((stat) => (
                <div class="stat">
                  <p class="stat__value">{stat.value}</p>
                  <p class="stat__label">{stat.label}</p>
                </div>
              ))}
            </div>
          )}

          {slide.bullets && (
            <ul class="slide__bullets">
              {slide.bullets.map((b) => (
                <li>
                  {b.term && <strong>{b.term}.</strong>} {b.text}
                </li>
              ))}
            </ul>
          )}

          {slide.table && (
            <div class="slide__tablewrap">
              <table class="slide__table">
                <thead>
                  <tr>
                    <th scope="col">{slide.table.head[0]}</th>
                    <th scope="col">{slide.table.head[1]}</th>
                  </tr>
                </thead>
                <tbody>
                  {slide.table.rows.map((row) => (
                    <tr>
                      <th scope="row">{row[0]}</th>
                      <td>{row[1]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {slide.note && <p class="slide__note">{slide.note}</p>}
          {slide.source && <p class="slide__source">Source: {slide.source}</p>}
        </article>
      ))
    }
  </div>

  <div class="deck__nav" data-deck-nav hidden>
    <button type="button" data-deck-prev>← Previous</button>
    <button type="button" data-deck-next>Next →</button>
  </div>
</figure>

<style>
  .deck {
    margin: var(--s-5) 0 var(--s-7);
  }

  .deck__bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    margin-bottom: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .deck__label {
    font-weight: 700;
    color: var(--accent-2);
  }

  .deck__count {
    color: var(--text-faint);
  }

  .deck__stage {
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .slide {
    padding: clamp(1.1rem, 4vw, 2rem);
    /* Holds the deck's height steady across slides of different lengths, so the
       Next button does not walk up and down the page as you step through. */
    min-height: 22rem;
  }

  /* Only reachable with JS off, where the slides stack into a list. */
  .slide + .slide {
    border-top: 1px solid var(--border);
  }

  .slide__num {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
    margin-bottom: var(--s-3);
  }

  .slide__kicker {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s-2);
  }

  .slide__title {
    font-size: var(--t-lg);
  }

  .slide__lede {
    margin-top: var(--s-3);
    color: var(--text-muted);
  }

  .slide__stats {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-5);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }

  .stat {
    padding: var(--s-3);
    border-radius: var(--r-md);
    background: var(--bg-sunken);
  }

  .stat__value {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 900;
    line-height: 1;
    color: var(--accent);
  }

  .stat__label {
    margin-top: var(--s-2);
    font-size: var(--t-xs);
    color: var(--text-muted);
  }

  .slide__bullets {
    margin-top: var(--s-4);
    padding-left: 1.15em;
    font-size: var(--t-sm);
  }

  .slide__bullets li + li {
    margin-top: var(--s-3);
  }

  .slide__tablewrap {
    margin-top: var(--s-4);
    overflow-x: auto;
  }

  .slide__table {
    border-collapse: collapse;
    width: 100%;
    font-size: var(--t-sm);
    text-align: left;
  }

  .slide__table th,
  .slide__table td {
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .slide__table thead th {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .slide__table tbody th {
    white-space: nowrap;
    color: var(--accent);
  }

  .slide__note {
    margin-top: var(--s-4);
    padding: var(--s-3);
    border-radius: var(--r-md);
    background: var(--accent-soft);
    font-size: var(--t-sm);
  }

  .slide__source {
    margin-top: var(--s-4);
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  .deck__nav {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .deck__nav button {
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-full);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--t-sm);
  }

  .deck__nav button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .deck__nav button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media print {
    .deck__nav {
      display: none;
    }

    .slide[hidden] {
      display: block !important;
    }
  }
</style>

<script>
  for (const deck of document.querySelectorAll<HTMLElement>('[data-slide-deck]')) {
    const slides = [...deck.querySelectorAll<HTMLElement>('[data-slide]')];
    const nav = deck.querySelector<HTMLElement>('[data-deck-nav]');
    const count = deck.querySelector<HTMLElement>('[data-deck-count]');
    const prev = deck.querySelector<HTMLButtonElement>('[data-deck-prev]');
    const next = deck.querySelector<HTMLButtonElement>('[data-deck-next]');
    if (slides.length < 2 || !nav || !count || !prev || !next) continue;

    nav.hidden = false;
    let at = 0;

    const show = (i: number) => {
      at = Math.max(0, Math.min(slides.length - 1, i));
      slides.forEach((s, n) => (s.hidden = n !== at));
      count.textContent = `${at + 1} / ${slides.length}`;
      prev.disabled = at === 0;
      next.disabled = at === slides.length - 1;
    };

    show(0);

    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));

    // Arrow keys, but only once the reader is inside the deck — otherwise they
    // would fight the page scroll for someone who never looked at it.
    deck.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(at - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(at + 1);
      }
    });
  }
</script>
