---
/**
 * The Super Mario Effect, as a thing that happens to you rather than a thing
 * you read about.
 *
 * Mark Rober ran a coding puzzle past ~50,000 people. Identical puzzle, one
 * difference in wording: half were told a failed attempt cost them 5 points,
 * half were just told to try again. The penalty group succeeded 52% of the
 * time; the no-penalty group, 68% — and tried far more often.
 *
 * You play it here in whichever framing you pick, and the numbers come after.
 */
---

<div class="mario" data-mario>
  <div class="mario__mode">
    <span class="mario__mode-label">Framing</span>
    <div class="switch" role="radiogroup" aria-label="Failure framing">
      <button type="button" role="radio" aria-checked="true" data-mode="safe">
        "Try again!"
      </button>
      <button type="button" role="radio" aria-checked="false" data-mode="penalty">
        "−5 points"
      </button>
    </div>
  </div>

  <div class="mario__game">
    <p class="mario__brief">
      A three-digit lock. Enter a guess and each dial tells you whether it's too high or too low.
      Nothing else. Go.
    </p>

    <div class="dials" data-mario-dials>
      {
        [0, 1, 2].map((i) => (
          <div class="dial">
            <input
              type="number"
              min="0"
              max="9"
              inputmode="numeric"
              value="0"
              data-dial={i}
              aria-label={`Digit ${i + 1}`}
            />
            <span class="dial__hint" data-hint={i}>
              ?
            </span>
          </div>
        ))
      }
    </div>

    <div class="mario__actions">
      <button type="button" class="mario__go" data-mario-guess>Try the lock</button>
      <button type="button" class="mario__reset" data-mario-reset>New lock</button>
    </div>

    <p class="mario__feedback" data-mario-feedback role="status" aria-live="polite">
      Nothing tried yet.
    </p>

    <div class="mario__score">
      <span data-mario-attempts>0</span> attempts
      <span class="mario__points" data-mario-points-wrap hidden>
        · <span data-mario-points>200</span> points
      </span>
    </div>
  </div>

  <div class="mario__reveal" data-mario-reveal hidden>
    <p class="eyebrow">You got it in <span data-mario-final>0</span></p>
    <h3>That was the experiment</h3>
    <p>
      Mark Rober gave the same puzzle to about 50,000 people. The puzzle was identical for everyone.
      The only thing that changed was one line of wording — whether a failed attempt cost you five
      points, or just said "that didn't work, try again."
    </p>
    <div class="results">
      <div class="result">
        <span class="result__n">52%</span>
        <span class="result__l">succeeded — the group that was penalized</span>
      </div>
      <div class="result result--win">
        <span class="result__n">68%</span>
        <span class="result__l">succeeded — the group that wasn't</span>
      </div>
    </div>
    <p>
      The unpenalized group also tried <strong>two and a half times more often</strong>. Nobody got
      smarter. The failure just stopped being about them.
    </p>
    <p class="mario__moral">
      This is why my students deploy in week seven and break things in week eight, and why "it
      crashed" is a normal sentence in my classroom rather than a confession.
    </p>
    <button type="button" class="mario__again" data-mario-swap>
      Now try it with the other framing →
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mario]');

  if (root) {
    const dials = [...root.querySelectorAll<HTMLInputElement>('[data-dial]')];
    const hints = [...root.querySelectorAll<HTMLElement>('[data-hint]')];
    const guessBtn = root.querySelector<HTMLButtonElement>('[data-mario-guess]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-mario-reset]')!;
    const feedback = root.querySelector<HTMLElement>('[data-mario-feedback]')!;
    const attemptsEl = root.querySelector<HTMLElement>('[data-mario-attempts]')!;
    const pointsWrap = root.querySelector<HTMLElement>('[data-mario-points-wrap]')!;
    const pointsEl = root.querySelector<HTMLElement>('[data-mario-points]')!;
    const reveal = root.querySelector<HTMLElement>('[data-mario-reveal]')!;
    const finalEl = root.querySelector<HTMLElement>('[data-mario-final]')!;
    const swapBtn = root.querySelector<HTMLButtonElement>('[data-mario-swap]')!;
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];

    let secret: number[] = [];
    let attempts = 0;
    let points = 200;
    let mode: 'safe' | 'penalty' = 'safe';
    let solved = false;

    const nudges = [
      "Not it — but you know more than you did. Try again!",
      "Nope! Keep going, you're closing in.",
      "Wrong, and that's fine. Have another go.",
      "Not yet. The dials are telling you something.",
    ];

    function newLock() {
      secret = Array.from({ length: 3 }, () => Math.floor(Math.random() * 10));
      attempts = 0;
      points = 200;
      solved = false;
      attemptsEl.textContent = '0';
      pointsEl.textContent = '200';
      feedback.textContent = 'Nothing tried yet.';
      feedback.className = 'mario__feedback';
      hints.forEach((h) => {
        h.textContent = '?';
        h.className = 'dial__hint';
      });
      reveal.hidden = true;
      guessBtn.disabled = false;
    }

    function setMode(next: 'safe' | 'penalty') {
      mode = next;
      modeBtns.forEach((b) =>
        b.setAttribute('aria-checked', b.dataset.mode === next ? 'true' : 'false'),
      );
      pointsWrap.hidden = next !== 'penalty';
      newLock();
    }

    function guess() {
      if (solved) return;

      const entered = dials.map((d) => {
        const n = Number(d.value);
        return Number.isFinite(n) ? Math.min(9, Math.max(0, Math.trunc(n))) : 0;
      });
      entered.forEach((n, i) => (dials[i].value = String(n)));

      attempts += 1;
      attemptsEl.textContent = String(attempts);

      let correct = 0;
      entered.forEach((n, i) => {
        const hint = hints[i];
        if (n === secret[i]) {
          hint.textContent = '✓';
          hint.className = 'dial__hint is-correct';
          correct += 1;
        } else if (n < secret[i]) {
          hint.textContent = '↑';
          hint.className = 'dial__hint is-low';
        } else {
          hint.textContent = '↓';
          hint.className = 'dial__hint is-high';
        }
      });

      if (correct === 3) {
        solved = true;
        guessBtn.disabled = true;
        feedback.textContent = 'Open. Nicely done.';
        feedback.className = 'mario__feedback is-win';
        finalEl.textContent = `${attempts} ${attempts === 1 ? 'attempt' : 'attempts'}`;
        reveal.hidden = false;
        reveal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      if (mode === 'penalty') {
        points = Math.max(0, points - 5);
        pointsEl.textContent = String(points);
        feedback.textContent = `Incorrect. −5 points. You have ${points} left.`;
        feedback.className = 'mario__feedback is-penalty';
      } else {
        feedback.textContent = nudges[attempts % nudges.length];
        feedback.className = 'mario__feedback is-safe';
      }
    }

    guessBtn.addEventListener('click', guess);
    resetBtn.addEventListener('click', newLock);
    modeBtns.forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.mode as 'safe' | 'penalty')),
    );
    swapBtn.addEventListener('click', () => setMode(mode === 'safe' ? 'penalty' : 'safe'));

    dials.forEach((d) =>
      d.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') guess();
      }),
    );

    newLock();
  }
</script>

<style>
  .mario {
    display: grid;
    gap: var(--s-5);
  }

  .mario__mode {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .mario__mode-label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
  }

  .switch {
    display: inline-flex;
    padding: 3px;
    gap: 3px;
    border-radius: var(--r-full);
    background: var(--bg-sunken);
    border: 1px solid var(--border);
  }

  .switch button {
    border: 0;
    background: none;
    border-radius: var(--r-full);
    padding: 0.4em 0.95em;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--text-muted);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .switch button[aria-checked='true'] {
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow-sm);
  }

  .mario__brief {
    font-size: var(--t-sm);
    color: var(--text-muted);
    max-width: 42rem;
  }

  .dials {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .dial {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
  }

  .dial input {
    width: 3.4rem;
    height: 4rem;
    text-align: center;
    font-family: var(--f-mono);
    font-size: var(--t-xl);
    font-weight: 700;
    border-radius: var(--r-md);
    border: 2px solid var(--border-strong);
    background: var(--bg);
    -moz-appearance: textfield;
  }

  .dial input::-webkit-outer-spin-button,
  .dial input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .dial__hint {
    font-family: var(--f-mono);
    font-weight: 700;
    color: var(--text-faint);
  }

  .dial__hint.is-correct {
    color: var(--accent-2);
  }

  .dial__hint.is-low,
  .dial__hint.is-high {
    color: var(--accent);
  }

  .mario__actions {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-4);
    flex-wrap: wrap;
  }

  .mario__go,
  .mario__reset,
  .mario__again {
    padding: 0.62em 1.2em;
    border-radius: var(--r-full);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    font-weight: 700;
    font-size: var(--t-sm);
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .mario__go {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: var(--btn-bg);
  }

  .mario__go:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .mario__go:not(:disabled):hover,
  .mario__reset:hover,
  .mario__again:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .mario__feedback {
    margin-top: var(--s-4);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: var(--bg-sunken);
    color: var(--text-muted);
  }

  .mario__feedback.is-penalty {
    border-color: color-mix(in oklab, var(--accent-3) 45%, transparent);
    background: color-mix(in oklab, var(--accent-3) 12%, transparent);
    color: var(--accent-3);
  }

  .mario__feedback.is-safe {
    border-color: color-mix(in oklab, var(--accent-2) 40%, transparent);
    background: var(--accent-2-soft);
    color: var(--accent-2);
  }

  .mario__feedback.is-win {
    border-color: var(--accent-bright);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }

  .mario__score {
    margin-top: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .mario__reveal {
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--accent-bright);
    background: var(--accent-soft);
  }

  .mario__reveal > * + * {
    margin-top: var(--s-4);
  }

  .mario__reveal h3 {
    margin-top: var(--s-2);
  }

  .results {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .result {
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--bg-raised);
    border: 1px solid var(--border);
  }

  .result--win {
    border-color: var(--accent-2);
  }

  .result__n {
    display: block;
    font-family: var(--f-display);
    font-size: var(--t-2xl);
    font-weight: 900;
    line-height: 1;
    color: var(--text-muted);
  }

  .result--win .result__n {
    color: var(--accent-2);
  }

  .result__l {
    display: block;
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .mario__moral {
    font-style: italic;
  }
</style>
