---
interface Props {
  status: 'complete' | 'placeholder' | 'needs-file';
}

const { status } = Astro.props;

/**
 * Nothing is rendered for a finished page. Every real page here is written now,
 * so a "Written" badge on each one labels the norm rather than the exception —
 * it costs a glance and tells the reader nothing. What still earns a badge is a
 * page that is *not* done, which is the whole point of carrying the unfinished
 * ones over instead of hiding them.
 */
const label = {
  complete: null,
  placeholder: 'Placeholder',
  'needs-file': 'Needs a file',
}[status];
---

{label && <span class:list={['pill', `pill--${status}`]}>{label}</span>}

<style>
  .pill {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    padding: 0.15em 0.6em;
    border-radius: var(--r-full);
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .pill--complete {
    background: var(--accent-2-soft);
    color: var(--accent-2);
    border-color: color-mix(in oklab, var(--accent-2) 30%, transparent);
  }

  .pill--placeholder {
    background: var(--bg-sunken);
    color: var(--text-faint);
    border-color: var(--border);
  }

  .pill--needs-file {
    background: color-mix(in oklab, var(--accent-3) 14%, transparent);
    color: var(--accent-3);
    border-color: color-mix(in oklab, var(--accent-3) 34%, transparent);
  }
</style>
