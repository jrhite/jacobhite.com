---
/**
 * Lesson 02, live. The thing students always get wrong is wraparound:
 * x → a, y → b, z → c.
 *
 * The rule below is not an illustration of the code — it *is* the code. It
 * ships as a string, gets evaluated once on load, and the demo calls whatever
 * comes back. So there is only ever one copy: edit it and the strip changes,
 * break it and the strip breaks. Everything the lesson is not about (reading
 * the input, painting 26 cells, the arithmetic caption) stays in the script
 * below, out of the learner's way.
 */
import RuleEditor from './RuleEditor.astro';

const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];

const rule = `// letter: 0-25 (a = 0)
// shift: how far to slide it
function shiftLetter(letter, shift) {
  return (letter + shift) % 26
}`;

/** One-click ways in, for someone who doesn't yet know what to type. */
const variants = [
  {
    label: 'No wraparound',
    hint: 'Take the % 26 away and letters run off the end of the alphabet.',
    src: `// Where does 'z' go now?
function shiftLetter(letter, shift) {
  return letter + shift
}`,
  },
  {
    label: 'Wrap at 13',
    hint: 'Wrap halfway through the alphabet instead of at the end.',
    src: `// Half an alphabet.
function shiftLetter(letter, shift) {
  return (letter + shift) % 13
}`,
  },
  {
    label: 'Go backwards',
    hint: 'Shift the other way — and see why the + 26 has to be there.',
    src: `// + 26 keeps it from going negative
function shiftLetter(letter, shift) {
  return (letter - shift + 26) % 26
}`,
  },
];
---

<div class="caesar toy-split" data-caesar>
  <div class="toy-col">
    <span class="toy-col__label">Your message</span>

    <div class="toy-col__body">
      <div class="caesar__controls">
        <input type="text" data-caesar-input value="zulu zone at dawn" maxlength="60" spellcheck="false" aria-label="Your message" />

        <label class="field">
          <span class="field__label">
            Shift <output data-caesar-shift-out>3</output>
          </span>
          <input type="range" min="0" max="25" value="3" data-caesar-shift />
        </label>
      </div>

      <div class="caesar__out">
        <span class="caesar__out-key">Encrypted</span>
        <output data-caesar-output>cxox crqh dw gdzq</output>
      </div>

      <div class="caesar__strip" aria-hidden="true">
        {
          alphabet.map((letter, i) => (
            <div class="cell" data-cell={i}>
              <span class="cell__from">{letter}</span>
              <span class="cell__arrow">↓</span>
              <span class="cell__to" data-cell-to>
                {letter}
              </span>
            </div>
          ))
        }
      </div>

      <p class="caesar__math">
        <code data-caesar-math>shiftLetter(25, 3) → 2 · 'z' becomes 'c'</code>
      </p>
    </div>
  </div>

  <RuleEditor source={rule} label="The shiftLetter rule, editable" variants={variants} rows={5} />
</div>

<script>
  import { createRuleEditor } from '../scripts/rule-editor';

  const root = document.querySelector<HTMLElement>('[data-caesar]');

  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-caesar-input]')!;
    const shift = root.querySelector<HTMLInputElement>('[data-caesar-shift]')!;
    const shiftOut = root.querySelector<HTMLOutputElement>('[data-caesar-shift-out]')!;
    const output = root.querySelector<HTMLOutputElement>('[data-caesar-output]')!;
    const math = root.querySelector<HTMLElement>('[data-caesar-math]')!;
    const cells = [...root.querySelectorAll<HTMLElement>('[data-cell]')];

    const A = 'a'.charCodeAt(0);
    type Rule = (letter: number, shift: number) => number;

    let rule: Rule = (letter, by) => (letter + by) % 26;

    function compile(src: string): Rule {
      const made = new Function(
        `"use strict";${src};return typeof shiftLetter === 'function' ? shiftLetter : null;`,
      )();
      if (!made) throw new Error('No function called shiftLetter is defined.');
      if (typeof made(0, 0) !== 'number') throw new Error('shiftLetter has to return a number.');
      return made as Rule;
    }

    /**
     * Deliberately does not clamp into a-z. Running off the end of the alphabet
     * is the thing the lesson is about, so it has to be visible. Only genuinely
     * unpaintable answers become '?'.
     */
    function charFrom(base: number, n: number) {
      if (!Number.isFinite(n)) return '?';
      const code = base + Math.trunc(n);
      if (code < 32 || code > 0x10ffff) return '?';
      return String.fromCodePoint(code);
    }

    function render() {
      const by = Number(shift.value);
      shiftOut.textContent = String(by);

      try {
        let out = '';
        for (const ch of input.value.toLowerCase()) {
          const code = ch.charCodeAt(0);
          out += code >= A && code <= A + 25 ? charFrom(A, rule(code - A, by)) : ch;
        }
        output.textContent = out || ' ';

        cells.forEach((cell, i) => {
          const to = rule(i, by);
          cell.querySelector('[data-cell-to]')!.textContent = charFrom(65, to);
          // Flagged where the alphabet ran out *and* the rule did something
          // about it. Both halves matter: derived from the rule, so deleting the
          // % 26 correctly stops flagging anything and lets the letters run off
          // the end in plain sight; anchored to i + by > 25, so a rule that
          // simply moves letters elsewhere doesn't light up all 26.
          cell.classList.toggle('is-wrapped', Number.isFinite(to) && i + by > 25 && to !== i + by);
        });

        const first = input.value.toLowerCase().match(/[a-z]/)?.[0] ?? 'a';
        const from = first.charCodeAt(0) - A;
        const to = rule(from, by);
        math.textContent = `shiftLetter(${from}, ${by}) → ${to} · '${first}' becomes '${charFrom(A, to)}'`;
      } catch {
        /* A rule that throws mid-render leaves the last good paint on screen. */
      }
    }

    createRuleEditor<Rule>({
      root,
      compile,
      apply: (next) => (rule = next),
      render,
    });

    input.addEventListener('input', render);
    shift.addEventListener('input', render);
  }
</script>

<style>
  /* Layout comes from .toy-split in global.css so all three toys align. */
  .caesar__controls {
    display: grid;
    gap: var(--s-4);
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field__label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
  }

  .field__label output {
    color: var(--accent);
  }

  .field input[type='text'] {
    padding: 0.7em 0.9em;
    border-radius: var(--r-md);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    font-family: var(--f-mono);
  }

  .field input[type='range'] {
    accent-color: var(--accent-bright);
    width: 100%;
    height: 2.2em;
  }

  .caesar__out {
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--bg-invert);
    color: var(--text-invert);
    font-family: var(--f-mono);
    overflow-x: auto;
  }

  .caesar__out-key {
    display: block;
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: var(--s-2);
  }

  .caesar__out output {
    font-size: var(--t-lg);
    white-space: pre;
  }

  /* Two rows of 13 rather than one of 26: the strip now lives in a column,
     and 26 cells across half a page is unreadable at any viewport. */
  .caesar__strip {
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 3px;
  }

  .cell {
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: var(--s-2) 0;
    border-radius: var(--r-sm);
    background: var(--bg-sunken);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .cell__from {
    color: var(--text-faint);
  }

  .cell__arrow {
    color: var(--border-strong);
    font-size: 0.6rem;
  }

  .cell__to {
    font-weight: 700;
  }

  .cell.is-wrapped {
    background: color-mix(in oklab, var(--accent-3) 16%, transparent);
  }

  .cell.is-wrapped .cell__to {
    color: var(--accent-3);
  }

  .caesar__math {
    font-size: var(--t-sm);
  }

  .caesar__math code {
    background: var(--accent-soft);
    border-color: var(--accent-bright);
  }

</style>
