---
/**
 * "From First Marks to Cohesive Essays" — the Module 2 Unit 2 writing
 * infographic, built rather than exported.
 *
 * The original is a poster: one baked background, type sized for a sheet of
 * paper, and no text a reader can select, search or hear. Built from its own
 * content it takes the page tokens, reflows to one column on a phone, and the
 * stage ladder still reads as a ladder. The PDF stays downloadable beside it.
 *
 * The poster ran the six stages through six hues. That progression is carried
 * here by the numbers and the rail they sit on instead: a six-step rainbow has
 * no home in the token set, and hard-coding one would be wrong in one theme or
 * the other.
 */

const stages = [
  {
    age: '~1–3 yrs',
    title: 'Scribbling & drawing',
    text: 'Marks record ideas; children build fine motor control, grip, and the sense that print carries meaning (Reading Rockets; Voyager Sopris).',
    looksLike: 'scribbles, drawings, full-fist grip.',
  },
  {
    age: '~3–4 yrs',
    title: 'Letter-like forms & emerging letter formation',
    text: 'Mock letters and shapes appear; explicit, playful stroke and name-writing practice prevents bad habits later (Reading Universe; Cheyney-Collante et al., 2020).',
    looksLike: 'circles, lines, "pretend" letters.',
  },
  {
    age: '~4–5 yrs',
    title: 'Letter strings',
    text: 'Real letters strung together without spaces or sound matches; teaching letter names and sounds together builds alphabet knowledge (Piasta, Purpura, & Wagner, 2010).',
    looksLike: '"TBRMSS" — uppercase strings.',
  },
  {
    age: 'K–Gr. 1',
    title: 'Invented spelling — the graphophonemic breakthrough',
    text: 'Letters connect to sounds; words are spelled phonetically with spaces. Adult support linking sounds to symbols predicts stronger decoding (Bindman et al., 2014).',
    looksLike: '"I LK MI DG" (I like my dog).',
  },
  {
    age: 'Gr. 1–4',
    title: 'Conventional writing & sentence fluency',
    text: 'Spelling and punctuation become mostly accurate; automatic handwriting frees working memory for ideas, and sentences grow into paragraphs (Reading Rockets; Camp, 2012).',
    looksLike: 'readable sentences, simple paragraphs.',
  },
  {
    age: 'Gr. 5–12+',
    title: 'Clear & cohesive essay writing',
    text: 'Writers plan, draft and revise multi-paragraph texts for real audiences using academic language and genre structures; development continues across the lifespan and follows variable paths (Applebee et al., 2017).',
    looksLike: 'thesis-driven essays with evidence, cohesion and voice.',
  },
];

const strategies = [
  {
    title: 'Explicit strategy instruction (plan → draft → revise)',
    text: 'Model and gradually release planning routines for essays — claim, evidence, counterargument — the most effective adolescent writing intervention (Graham & Perin, 2007).',
  },
  {
    title: 'Sentence combining, not grammar drills',
    text: 'Combine kernel sentences ("The storm hit. The power failed.") into complex ones to build the syntax cohesive essays need (Graham & Perin, 2007).',
  },
  {
    title: 'Mentor texts & genre study',
    text: 'Analyze strong models of each genre so the features of academic writing — openings, transitions, cohesion — become consciously visible (Applebee et al., 2017).',
  },
  {
    title: 'Frames & scaffolds for multilingual learners',
    text: 'Temporary paragraph frames ("Although ___ argues ___, …"), sentence starters and transition word banks give English learners access to grade-level composition.',
  },
  {
    title: 'Targeted transcription support',
    text: 'Morphology-based spelling work, typing fluency and speech-to-text for students whose transcription still steals working memory from ideas (Camp, 2012; Reading Universe).',
  },
  {
    title: 'Frequent low-stakes writing + formative feedback',
    text: 'Journals and quick-writes with brief, criteria-based feedback; portfolios that foreground growth over time rather than one-shot grades (Camp, 2012).',
  },
];
---

<figure class="wp">
  <figcaption class="wp__head">
    <p class="wp__label">Infographic</p>
    <h4 class="wp__title">From first marks to cohesive essays</h4>
    <p class="wp__lede">
      The progression of writing development — letter formation → letter–sound connection
      (graphophonemic awareness) → clear, cohesive writing.
    </p>
  </figcaption>

  <ol class="ladder">
    {
      stages.map((stage, i) => (
        <li class="rung">
          <div class="rung__mark">
            <span class="rung__num">{i + 1}</span>
            <span class="rung__age">{stage.age}</span>
          </div>
          <div class="rung__body">
            <h5 class="rung__title">{stage.title}</h5>
            <p class="rung__text">{stage.text}</p>
            <p class="rung__looks">
              <span>Looks like:</span> {stage.looksLike}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="strat">
    <h5 class="strat__title">Intervention strategies — high school English, grades 9–12</h5>
    <p class="strat__lede">
      Target stage: <strong>stage 6, cohesive essay writing</strong> — but one classroom spans the
      range, so the strategies scaffold down to spelling and sentence level.
    </p>
    <ol class="strat__grid">
      {
        strategies.map((s) => (
          <li class="card">
            <h6 class="card__title">{s.title}</h6>
            <p class="card__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<style>
  .wp {
    margin: var(--s-5) 0 var(--s-7);
    padding: clamp(1.1rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .wp__label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-2);
  }

  .wp__title {
    margin-top: var(--s-2);
    font-size: var(--t-lg);
  }

  .wp__lede {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .ladder {
    margin-top: var(--s-5);
    padding: 0;
    list-style: none;
  }

  .rung {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: var(--s-4);
    padding-bottom: var(--s-4);
  }

  .rung + .rung {
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
  }

  .rung__mark {
    text-align: center;
  }

  .rung__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline: auto;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--f-display);
    font-size: var(--t-lg);
    font-weight: 900;
    line-height: 1;
  }

  .rung__age {
    display: block;
    margin-top: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  .rung__title {
    font-size: var(--t-base);
    color: var(--accent);
  }

  .rung__text {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
  }

  .rung__looks {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    font-style: italic;
    color: var(--text-muted);
  }

  .rung__looks span {
    font-style: normal;
    font-weight: 700;
  }

  .strat {
    margin-top: var(--s-5);
    padding: clamp(0.9rem, 3vw, 1.5rem);
    border-radius: var(--r-md);
    background: var(--bg-sunken);
  }

  .strat__title {
    font-size: var(--t-base);
  }

  .strat__lede {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .strat__grid {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-4);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    counter-reset: strat;
  }

  .card {
    counter-increment: strat;
  }

  .card__title {
    font-size: var(--t-sm);
    color: var(--accent);
  }

  .card__title::before {
    content: counter(strat) '. ';
  }

  .card__text {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
  }

  /* One column once the rail would squeeze the text into a sliver. */
  @media (max-width: 30rem) {
    .rung {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }

    .rung__mark {
      display: flex;
      align-items: center;
      gap: var(--s-3);
      text-align: left;
    }

    .rung__num {
      margin-inline: 0;
      width: 2rem;
      height: 2rem;
      font-size: var(--t-base);
    }

    .rung__age {
      margin-top: 0;
    }
  }
</style>
