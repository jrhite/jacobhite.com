---
import { Image } from 'astro:assets';
import { siteMeta } from '../data/nav';
import avatar from '../assets/jacob-hite-avatar.jpg';

interface Props {
  heading: string;
  body: string;
}

const { heading, body } = Astro.props;

/**
 * There is no contact address set yet (see siteMeta.email). Rather than shipping
 * a button that goes nowhere, the CTA degrades to an honest note until one exists.
 */
const email = siteMeta.email;
---

<section class="section page">
  <div class="cta">
    <div class="cta__text">
      <Image
        class="cta__face"
        src={avatar}
        alt={`${siteMeta.name}, mid-laugh, turned slightly away from the camera.`}
        widths={[88, 176]}
        sizes="88px"
        loading="lazy"
      />
      <h2>{heading}</h2>
      <p class="muted">{body}</p>
    </div>

    {
      email ? (
        <div class="cta__contact">
          <a class="cta__btn" href={`mailto:${email}`}>
            <svg class="cta__icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
              <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
            </svg>
            Email me
          </a>
          <a class="cta__addr" href={`mailto:${email}`}>{email}</a>
        </div>
      ) : (
        <p class="cta__pending">
          <span class="cta__pending-key">Contact details coming</span>
          An address for this goes here once it's set up.
        </p>
      )
    }
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    background: var(--accent-soft);
  }

  .cta__text {
    max-width: 40rem;
  }

  /* A face at the moment someone decides whether to write. */
  .cta__face {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: var(--r-full);
    object-fit: cover;
    margin-bottom: var(--s-4);
    border: 2px solid var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .cta h2 {
    font-size: var(--t-xl);
    margin-bottom: var(--s-2);
  }

  .cta__contact {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }

  .cta__icon {
    width: 1.05em;
    height: 1.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cta__addr {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-muted);
    text-decoration-color: var(--border-strong);
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.72em 1.35em;
    border-radius: var(--r-full);
    background: var(--btn-bg);
    color: var(--btn-fg);
    border: 1px solid var(--btn-bg);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: var(--btn-fg);
  }

  .cta__pending {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-muted);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-md);
    padding: var(--s-3) var(--s-4);
    max-width: 20rem;
  }

  .cta__pending-key {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-faint);
    margin-bottom: var(--s-1);
  }
</style>
