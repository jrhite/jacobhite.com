---
/**
 * An original pixel-art scene for the Super Mario Effect section: a jump over a
 * pit, and a dashed arc back to the start. No lecture, no scolding — just a
 * retry. Deliberately not any existing game's character or trademark.
 */
---

<figure class="respawn">
  <svg
    viewBox="0 0 320 160"
    role="img"
    aria-label="Pixel-art scene: a small figure leaps over a pit toward a flag, with a dashed arrow curving back to the start of the level."
    shape-rendering="crispEdges"
  >
    <!-- Coin popping out of the question block. -->
    <g class="coin">
      <rect x="94" y="20" width="12" height="12" />
      <rect x="90" y="24" width="20" height="4" />
    </g>

    <!-- The question block: the thing worth guessing at. -->
    <g class="block">
      <rect x="88" y="44" width="24" height="24" />
      <rect x="96" y="50" width="8" height="4" class="glyph" />
      <rect x="104" y="54" width="4" height="4" class="glyph" />
      <rect x="100" y="56" width="4" height="4" class="glyph" />
      <rect x="100" y="62" width="4" height="4" class="glyph" />
    </g>

    <!-- Motion lines: they were already moving when it went wrong. -->
    <g class="speed">
      <rect x="120" y="56" width="16" height="3" />
      <rect x="128" y="66" width="14" height="3" />
      <rect x="122" y="76" width="10" height="3" />
    </g>

    <!-- The player, mid-jump over the gap. -->
    <g transform="translate(148 44)">
      <rect x="10" y="0" width="20" height="6" class="cap" />
      <rect x="6" y="6" width="28" height="4" class="cap" />
      <rect x="10" y="10" width="20" height="8" class="body" />
      <rect x="22" y="12" width="4" height="4" class="eye" />
      <rect x="6" y="18" width="28" height="14" class="shirt" />
      <rect x="0" y="20" width="6" height="6" class="shirt" />
      <rect x="34" y="16" width="6" height="6" class="shirt" />
      <rect x="8" y="32" width="8" height="10" class="body" />
      <rect x="24" y="32" width="8" height="10" class="body" />
      <rect x="4" y="42" width="14" height="5" class="body" />
      <rect x="22" y="42" width="14" height="5" class="body" />
    </g>

    <!-- Ground, with the pit the whole lesson is about. -->
    <g class="ground">
      <rect x="0" y="96" width="144" height="24" />
      <rect x="200" y="96" width="120" height="24" />
    </g>
    <g class="seam">
      <rect x="32" y="96" width="2" height="24" />
      <rect x="72" y="96" width="2" height="24" />
      <rect x="112" y="96" width="2" height="24" />
      <rect x="232" y="96" width="2" height="24" />
      <rect x="272" y="96" width="2" height="24" />
    </g>

    <!-- Start of the level, and the flag you were aiming at. -->
    <g class="post">
      <rect x="20" y="76" width="4" height="20" />
      <rect x="14" y="92" width="16" height="4" />
    </g>
    <g class="flag">
      <rect x="288" y="40" width="4" height="56" class="pole" />
      <rect x="292" y="44" width="20" height="14" />
    </g>

    <!-- Fall in, and it just puts you back at the start. -->
    <path
      class="retry"
      d="M 176 134 Q 100 152 32 134"
      fill="none"
      shape-rendering="geometricPrecision"
    />
    <path class="retry-head" d="M 32 134 l 12 -6 l 0 12 z" />
  </svg>
  <figcaption>
    Fall in the pit and nothing tells you you're a bad person. You start the level again.
  </figcaption>
</figure>

<style>
  .respawn {
    margin: 0;
  }

  .respawn svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-sunken);
  }

  .coin rect {
    fill: var(--accent);
  }

  .block rect {
    fill: var(--accent-bright);
  }

  .block .glyph {
    fill: var(--ink-950);
  }

  .speed rect {
    fill: var(--border-strong);
  }

  .cap {
    fill: var(--accent);
  }

  .shirt {
    fill: var(--accent-2);
  }

  .body {
    fill: var(--text);
  }

  .eye {
    fill: var(--bg-sunken);
  }

  .ground rect {
    fill: var(--border);
  }

  .seam rect,
  .post rect {
    fill: var(--border-strong);
  }

  .flag rect {
    fill: var(--accent-3);
  }

  .flag .pole {
    fill: var(--border-strong);
  }

  .retry {
    stroke: var(--text-faint);
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }

  .retry-head {
    fill: var(--text-faint);
  }

  .respawn figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }
</style>
