---
/**
 * Lesson 04, live. An object used as a counter — the moment students stop
 * thinking of objects as "records" and start thinking of them as lookup tables.
 *
 * The rule below is the code the demo runs, not a picture of it: edit the
 * tally and the bars change. The chart, the stats and the sorting are
 * machinery, and stay out of the way in the script.
 */
import RuleEditor from './RuleEditor.astro';

const sample = `The best way to learn to program is to write programs.
Not to read about writing programs. Not to watch someone write programs.
To write them, badly, and then to write them again.`;

const rule = `// Tally each word by name,
// not by position.
function countWords(words) {
  const counts = {}
  for (const word of words) {
    counts[word] = (counts[word] || 0) + 1
  }
  return counts
}`;

const variants = [
  {
    label: 'Count letters',
    hint: 'Tally word lengths instead of the words themselves.',
    src: `// Keys can be anything.
function countWords(words) {
  const counts = {}
  for (const word of words) {
    const key = word.length + ' letters'
    counts[key] = (counts[key] || 0) + 1
  }
  return counts
}`,
  },
  {
    label: 'First letters',
    hint: 'Tally by opening letter — the same object, a different question.',
    src: `// Group by first letter.
function countWords(words) {
  const counts = {}
  for (const word of words) {
    const key = word[0]
    counts[key] = (counts[key] || 0) + 1
  }
  return counts
}`,
  },
  {
    label: 'Forget the + 1',
    hint: 'Drop the running total and watch every count stick at one.',
    src: `// No running total.
function countWords(words) {
  const counts = {}
  for (const word of words) {
    counts[word] = 1
  }
  return counts
}`,
  },
];

---

<div class="wc toy-split" data-wc>
  <div class="toy-col">
    <span class="toy-col__label">Paste any text to count words for</span>

    <div class="toy-col__body">
      <textarea data-wc-input rows="4" spellcheck="false" aria-label="Text to count words for">{sample}</textarea>

      <div class="wc__stats">
        <div class="stat"><span data-wc-total>0</span><small>words</small></div>
        <div class="stat"><span data-wc-unique>0</span><small>unique</small></div>
        <div class="stat"><span data-wc-longest>—</span><small>longest</small></div>
      </div>

      <ol class="wc__chart" data-wc-chart></ol>
    </div>
  </div>

  <RuleEditor source={rule} label="The countWords rule, editable" variants={variants} rows={8} />
</div>

<script>
  import { createRuleEditor } from '../scripts/rule-editor';

  const root = document.querySelector<HTMLElement>('[data-wc]');

  if (root) {
    const input = root.querySelector<HTMLTextAreaElement>('[data-wc-input]')!;
    const chart = root.querySelector<HTMLElement>('[data-wc-chart]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-wc-total]')!;
    const uniqueEl = root.querySelector<HTMLElement>('[data-wc-unique]')!;
    const longestEl = root.querySelector<HTMLElement>('[data-wc-longest]')!;

    type Tally = (words: string[]) => Record<string, number>;

    let tally: Tally = (words) => {
      const counts: Record<string, number> = {};
      for (const word of words) counts[word] = (counts[word] || 0) + 1;
      return counts;
    };

    function compile(src: string): Tally {
      const made = new Function(
        `"use strict";${src};return typeof countWords === 'function' ? countWords : null;`,
      )();
      if (!made) throw new Error('No function called countWords is defined.');
      const probe = made(['a', 'a', 'b']);
      if (!probe || typeof probe !== 'object') throw new Error('countWords has to return an object.');
      return made as Tally;
    }

    /**
     * Splitting the text into words is machinery, not the lesson — the rule in
     * the editor gets a clean array and decides only what to do with it.
     */
    function wordsIn(text: string) {
      return text
        .toLowerCase()
        .replace(/[^a-z\s]/g, '')
        .split(/\s+/)
        .filter(Boolean);
    }

    function render() {
      let counts: Record<string, number> = {};
      try {
        counts = tally(wordsIn(input.value)) ?? {};
      } catch {
        /* Keep the last good chart on screen rather than blanking it. */
        return;
      }

      const entries = Object.entries(counts)
        .filter(([, n]) => Number.isFinite(n))
        .sort((a, b) => b[1] - a[1]);
      const total = entries.reduce((sum, [, n]) => sum + n, 0);
      const max = entries[0]?.[1] ?? 1;

      totalEl.textContent = String(total);
      uniqueEl.textContent = String(entries.length);
      longestEl.textContent =
        entries.map(([w]) => w).sort((a, b) => b.length - a.length)[0] ?? '—';

      chart.replaceChildren(
        ...entries.slice(0, 10).map(([word, n]) => {
          const li = document.createElement('li');
          li.className = 'bar';

          const label = document.createElement('span');
          label.className = 'bar__word';
          label.textContent = word;

          const track = document.createElement('span');
          track.className = 'bar__track';
          const fill = document.createElement('span');
          fill.className = 'bar__fill';
          fill.style.width = `${Math.max(0, Math.min(100, (n / max) * 100))}%`;
          track.append(fill);

          const num = document.createElement('span');
          num.className = 'bar__n';
          num.textContent = String(n);

          li.append(label, track, num);
          return li;
        }),
      );
    }

    createRuleEditor<Tally>({
      root,
      compile,
      apply: (next) => (tally = next),
      render,
    });

    input.addEventListener('input', render);
  }
</script>

<style>
  /* Layout comes from .toy-split in global.css so all three toys align. */
  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field__label {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
  }

  textarea {
    width: 100%;
    padding: 0.8em 0.9em;
    border-radius: var(--r-md);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    resize: vertical;
  }

  .wc__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .stat {
    text-align: center;
    padding: var(--s-3);
    border-radius: var(--r-md);
    background: var(--bg-sunken);
  }

  .stat span {
    display: block;
    font-family: var(--f-display);
    font-size: var(--t-xl);
    font-weight: 900;
    color: var(--accent);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .stat small {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .wc__chart {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }

  .wc__chart :global(.bar) {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 2rem;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--t-sm);
  }

  .wc__chart :global(.bar__word) {
    text-align: right;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wc__chart :global(.bar__track) {
    height: 1.1rem;
    background: var(--bg-sunken);
    border-radius: var(--r-full);
    overflow: hidden;
  }

  .wc__chart :global(.bar__fill) {
    display: block;
    height: 100%;
    border-radius: var(--r-full);
    background: linear-gradient(90deg, var(--accent-2), var(--accent-bright));
    transition: width var(--dur) var(--ease);
  }

  .wc__chart :global(.bar__n) {
    font-weight: 700;
  }

</style>
