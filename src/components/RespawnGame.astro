---
/**
 * The Super Mario Effect, playable.
 *
 * This was a still picture of a jump, which asked you to take the point on
 * trust. The point is a feeling — that falling in costs you nothing but the
 * walk back — and you can't get a feeling from a diagram. So you run it: jump
 * the pit, miss it, and watch what happens, which is nothing except starting
 * over.
 *
 * The panel beside it is not a picture of the loop — it is the loop. The rule
 * ships as a string, gets evaluated, and the engine calls whatever comes back,
 * so there is only one copy and it cannot drift. Falling in lights up the line
 * that ran, and there is no line to punish you, because there is no punishment
 * to implement — the lesson stated in the only place a programmer really reads.
 * Anyone who doubts it can add `world.lose(5)` and watch the page argue with
 * itself.
 *
 * Deliberately not any existing game's character or trademark.
 */
import RuleEditor from './RuleEditor.astro';

/**
 * Kept to short lines on purpose: this panel sits in a half-width column, and
 * a line that wraps is a line a learner has to reassemble in their head.
 */
const rule = `const GRAVITY = 0.3
const JUMP    = -5.2
const SPEED   =  2.0

// One step of the world.
function step(p, world) {
  if (p.jumped && p.onGround) {
    p.vy = JUMP
    p.onGround = false
  }

  p.vy += GRAVITY
  p.y  += p.vy
  p.x  += SPEED

  if (world.landed(p)) {
    p.y  = world.FLOOR
    p.vy = 0
    p.onGround = true
  }

  if (p.y > world.PIT_BOTTOM) {
    world.fall()
    // no points lost. no lecture.
  }

  if (p.x >= world.FLAG_X) {
    world.win()
  }
}`;

const variants = [
  {
    label: 'Punish the miss',
    hint: 'Add the one line this whole page is an argument against.',
    src: `const GRAVITY = 0.3
const JUMP    = -5.2
const SPEED   =  2.0

function step(p, world) {
  if (p.jumped && p.onGround) {
    p.vy = JUMP
    p.onGround = false
  }

  p.vy += GRAVITY
  p.y  += p.vy
  p.x  += SPEED

  if (world.landed(p)) {
    p.y  = world.FLOOR
    p.vy = 0
    p.onGround = true
  }

  if (p.y > world.PIT_BOTTOM) {
    world.fall()
    world.lose(5)
  }

  if (p.x >= world.FLAG_X) {
    world.win()
  }
}`,
  },
  {
    label: 'Moon gravity',
    hint: 'Same code, one number. Physics is just constants.',
    src: `const GRAVITY = 0.08
const JUMP    = -3.2
const SPEED   =  2.0

function step(p, world) {
  if (p.jumped && p.onGround) {
    p.vy = JUMP
    p.onGround = false
  }

  p.vy += GRAVITY
  p.y  += p.vy
  p.x  += SPEED

  if (world.landed(p)) {
    p.y  = world.FLOOR
    p.vy = 0
    p.onGround = true
  }

  if (p.y > world.PIT_BOTTOM) {
    world.fall()
  }

  if (p.x >= world.FLAG_X) {
    world.win()
  }
}`,
  },
  {
    label: 'Never fall',
    hint: 'Delete the pit check. Where does the player end up?',
    src: `const GRAVITY = 0.3
const JUMP    = -5.2
const SPEED   =  2.0

function step(p, world) {
  if (p.jumped && p.onGround) {
    p.vy = JUMP
    p.onGround = false
  }

  p.vy += GRAVITY
  p.y  += p.vy
  p.x  += SPEED

  if (world.landed(p)) {
    p.y  = world.FLOOR
    p.vy = 0
    p.onGround = true
  }

  if (p.x >= world.FLAG_X) {
    world.win()
  }
}`,
  },
];

---

<div class="rg toy-split" data-rg>
  <div class="toy-col">
    <span class="toy-col__label">Jump the pit</span>

    <div class="toy-col__body rg__play">
    <div class="rg__stage" data-rg-stage>
      <svg viewBox="0 0 320 160" shape-rendering="crispEdges" aria-hidden="true">
        <!-- Ground, with the pit the whole lesson is about. -->
        <g class="ground">
          <rect x="0" y="96" width="144" height="24"></rect>
          <rect x="196" y="96" width="124" height="24"></rect>
        </g>
        <g class="seam">
          <rect x="32" y="96" width="2" height="24"></rect>
          <rect x="72" y="96" width="2" height="24"></rect>
          <rect x="112" y="96" width="2" height="24"></rect>
          <rect x="232" y="96" width="2" height="24"></rect>
          <rect x="272" y="96" width="2" height="24"></rect>
        </g>

        <!-- Start of the level, and the flag you were aiming at. -->
        <g class="post">
          <rect x="20" y="76" width="4" height="20"></rect>
          <rect x="14" y="92" width="16" height="4"></rect>
        </g>
        <g class="flag" data-rg-flag>
          <rect x="288" y="40" width="4" height="56" class="pole"></rect>
          <rect x="292" y="44" width="20" height="14"></rect>
        </g>

        <!-- The player. Its group transform is the whole of `player.x/y`. -->
        <g class="player" data-rg-player transform="translate(8 49)">
          <rect x="10" y="0" width="20" height="6" class="cap"></rect>
          <rect x="6" y="6" width="28" height="4" class="cap"></rect>
          <rect x="10" y="10" width="20" height="8" class="skin"></rect>
          <rect x="22" y="12" width="4" height="4" class="eye"></rect>
          <rect x="6" y="18" width="28" height="14" class="shirt"></rect>
          <rect x="0" y="20" width="6" height="6" class="shirt"></rect>
          <rect x="34" y="16" width="6" height="6" class="shirt"></rect>
          <g class="leg leg--l" data-rg-leg-l>
            <rect x="8" y="32" width="8" height="10" class="skin"></rect>
            <rect x="4" y="42" width="14" height="5" class="skin"></rect>
          </g>
          <g class="leg leg--r" data-rg-leg-r>
            <rect x="24" y="32" width="8" height="10" class="skin"></rect>
            <rect x="22" y="42" width="14" height="5" class="skin"></rect>
          </g>
        </g>
      </svg>

      <button class="rg__hit" type="button" data-rg-jump>
        <span class="visually-hidden">Jump</span>
      </button>

      <p class="rg__banner" data-rg-banner hidden></p>
    </div>

    <div class="rg__hud">
      <p class="rg__status" data-rg-status role="status" aria-live="polite">
        Press <kbd>Space</kbd> to start. Then press it again to jump.
      </p>
      <div class="rg__meta">
        <span><strong data-rg-attempts>0</strong> <span data-rg-attempts-word>attempts</span></span>
        <span class="rg__cost">points lost: <strong data-rg-cost>0</strong></span>
      </div>
      <div class="rg__controls">
        <button type="button" class="rg__btn rg__btn--go" data-rg-jump>Jump</button>
        <button type="button" class="rg__btn" data-rg-reset>Start over</button>
      </div>
      </div>
    </div>
  </div>

  <RuleEditor source={rule} label="The step rule, editable" variants={variants} rows={28} />
</div>

<style>
  /* Layout comes from .toy-split in global.css so all three toys align. */

  /* ---- the game ---- */

  .rg__play {
    min-width: 0;
  }

  .rg__stage {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-sunken);
    overflow: hidden;
  }

  .rg__stage svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A full-bleed target so tapping the picture is jumping, which is what
     everyone tries first. The visible button stays for keyboard and for
     anyone who'd rather press a labeled control. */
  .rg__hit {
    position: absolute;
    inset: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .rg__banner {
    position: absolute;
    inset-inline: 0;
    top: 12%;
    margin: 0;
    text-align: center;
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(1.1rem, 4vw, 1.6rem);
    color: var(--text);
    text-shadow: 0 2px 0 var(--bg-sunken);
    pointer-events: none;
  }

  .rg__banner[data-tone='win'] {
    color: var(--accent-2);
  }

  .rg__hud {
    margin-top: var(--s-4);
  }

  .rg__status {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--text-muted);
    min-height: 2.6em;
  }

  .rg__status kbd {
    font-family: var(--f-mono);
    font-size: 0.9em;
    padding: 0.1em 0.4em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--bg-raised);
  }

  .rg__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-3);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--text-faint);
  }

  .rg__cost strong {
    color: var(--accent-2);
  }

  .rg__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .rg__btn {
    padding: var(--s-2) var(--s-4);
    border-radius: var(--r-full);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    font-size: var(--t-sm);
    font-weight: 600;
  }

  .rg__btn--go {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: transparent;
  }

  .rg__btn:hover {
    border-color: var(--accent);
  }

  /* ---- pixel art ---- */

  .cap {
    fill: var(--accent);
  }
  .shirt {
    fill: var(--accent-2);
  }
  .skin {
    fill: var(--text);
  }
  .eye {
    fill: var(--bg-sunken);
  }
  .ground rect {
    fill: var(--border);
  }
  .seam rect,
  .post rect,
  .flag .pole {
    fill: var(--border-strong);
  }
  .flag rect {
    fill: var(--accent-3);
  }

  .leg {
    transition: transform 90ms steps(1);
  }

  .player.is-airborne .leg--l {
    transform: translateY(-3px);
  }

  .player.is-airborne .leg--r {
    transform: translateY(2px);
  }

  .player.is-stepping .leg--l {
    transform: translate(3px, -2px);
  }

  .player.is-stepping .leg--r {
    transform: translate(-3px, 0);
  }

  /* ---- the code panel ---- */










  @media (prefers-reduced-motion: reduce) {
    .leg {
      transition: none;
    }
  }
</style>

<script>
  import { createRuleEditor } from '../scripts/rule-editor';

  const root = document.querySelector<HTMLElement>('[data-rg]');

  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-rg-stage]')!;
    const svgPlayer = root.querySelector<SVGGElement>('[data-rg-player]')!;
    const banner = root.querySelector<HTMLElement>('[data-rg-banner]')!;
    const status = root.querySelector<HTMLElement>('[data-rg-status]')!;
    const attemptsEl = root.querySelector<HTMLElement>('[data-rg-attempts]')!;
    const attemptsWordEl = root.querySelector<HTMLElement>('[data-rg-attempts-word]')!;

    /** Keeps the count and its noun in agreement — "1 attempts" reads as a bug. */
    const setAttempts = (n: number) => {
      attemptsEl.textContent = String(n);
      attemptsWordEl.textContent = n === 1 ? 'attempt' : 'attempts';
    };
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-rg-reset]')!;
    const jumpBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-rg-jump]')];
    const costEl = root.querySelector<HTMLElement>('[data-rg-cost]')!;

    // World constants the rule does not own, in the SVG's own units.
    const GROUND = 49; // player `y` when standing
    const PIT_BOTTOM = 130;
    const PIT_FROM = 144;
    const PIT_TO = 196;
    const FLAG_X = 276;
    const START_X = 8;

    const player = { x: START_X, y: GROUND, vy: 0, onGround: true, jumped: false };

    type Step = (p: typeof player, world: World) => void;
    type World = {
      FLOOR: number;
      PIT_BOTTOM: number;
      FLAG_X: number;
      landed: (p: typeof player) => boolean;
      fall: () => void;
      win: () => void;
      lose: (n: number) => void;
    };

    let step: Step = () => {};
    let attempts = 0;
    let running = false;
    let finished = false;
    let queuedJump = false;
    let raf = 0;
    let last = 0;
    let accumulator = 0;
    let stepPhase = 0;

    let pointsLost = 0;

    /**
     * Highlight the line that just ran. Matched by pattern rather than by line
     * number, because the learner is editing this document — a cached number
     * would point at the wrong line the moment they add one, and if they delete
     * the line nothing lights up, which is the honest answer.
     */
    let clearMark: number | undefined;
    const mark = (pattern: RegExp, ms = 900) => {
      editor.markLine(pattern);
      window.clearTimeout(clearMark);
      clearMark = window.setTimeout(() => editor.markLine(null), ms);
    };

    const say = (html: string) => {
      status.innerHTML = html;
    };

    const showBanner = (text: string, tone?: string) => {
      banner.textContent = text;
      banner.hidden = false;
      if (tone) banner.dataset.tone = tone;
      else delete banner.dataset.tone;
    };

    const hideBanner = () => {
      banner.hidden = true;
      delete banner.dataset.tone;
    };

    const draw = () => {
      svgPlayer.setAttribute('transform', `translate(${player.x.toFixed(2)} ${player.y.toFixed(2)})`);
      svgPlayer.classList.toggle('is-airborne', !player.onGround);
      svgPlayer.classList.toggle('is-stepping', player.onGround && stepPhase > 0.5);
    };

    const respawn = () => {
      player.x = START_X;
      player.y = GROUND;
      player.vy = 0;
      player.onGround = true;
    };

    const overPit = () => {
      const center = player.x + 20;
      return center > PIT_FROM && center < PIT_TO;
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    const win = () => {
      finished = true;
      stop();
      // The successful run is an attempt too. Without this the prose said
      // "attempt 1" while the counter beside it still read 0.
      attempts += 1;
      setAttempts(attempts);
      mark(/world\.win/, 4000);
      showBanner('You got there.', 'win');
      /**
       * The claim "nothing was deducted" is only true while nobody has added a
       * penalty. Once `world.lose` has fired, saying it anyway makes the page
       * look broken rather than makes the argument — so name the contradiction
       * instead of denying it. This is the "argue with itself" moment.
       */
      say(
        pointsLost > 0
          ? `Cleared it on attempt <strong>${attempts}</strong> — and <strong>${pointsLost}</strong> points ` +
            'went somewhere on the way. Nothing in the world needed them: you added that line, and the ' +
            'run played out exactly the same without it.'
          : `Cleared it on attempt <strong>${attempts}</strong>. Nothing was deducted along the way — ` +
            'the only thing the misses cost you was the walk back.',
      );
    };

    const fall = () => {
      attempts += 1;
      setAttempts(attempts);
      mark(/world\.fall/);
      showBanner('Try again');
      say(
        `That didn't work. Attempt <strong>${attempts}</strong> — you're back at the start, ` +
          'with everything you had before.',
      );
      respawn();
      window.setTimeout(hideBanner, 900);
    };

    /**
     * A fixed step, so the rule on the right never has to mention `dt`. The
     * engine catches up by running whole steps rather than scaling a frame, and
     * the numbers a learner reads are the numbers actually applied.
     */
    const STEP_MS = 1000 / 60;

    const world = {
      FLOOR: GROUND,
      PIT_BOTTOM,
      FLAG_X,
      landed: (p: typeof player) =>
        (p.onGround || (p.vy > 0 && p.y >= GROUND)) && !overPit(),
      fall: () => fall(),
      win: () => win(),
      lose: (n: number) => {
        pointsLost += Number(n) || 0;
        costEl.textContent = String(pointsLost);
      },
    };

    const frame = (now: number) => {
      // Clamped at both ends: the ceiling stops a backgrounded tab teleporting
      // the player, and the floor stops a non-monotonic clock running it back.
      accumulator += Math.min(Math.max(now - last, 0), STEP_MS * 4);
      last = now;

      let steps = 0;
      while (accumulator >= STEP_MS && steps < 4 && running && !finished) {
        accumulator -= STEP_MS;
        steps += 1;

        player.jumped = queuedJump;
        queuedJump = false;

        try {
          step(player, world);
        } catch (err) {
          // A rule that throws stops the run rather than spinning on the error.
          running = false;
          say(`The rule threw: <strong>${err instanceof Error ? err.message : String(err)}</strong>`);
          break;
        }

        if (player.jumped && !player.onGround) mark(/p\.vy = JUMP/, 320);
      }

      stepPhase = (player.x / 9) % 1;
      draw();

      if (running && !finished) raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running || finished) return;
      running = true;
      hideBanner();
      say('Running. Press <kbd>Space</kbd>, or tap the picture, to jump the pit.');
      last = performance.now();
      accumulator = 0;
      raf = requestAnimationFrame(frame);
    };

    const onJump = () => {
      if (finished) return;
      if (!running) {
        start();
        return;
      }
      queuedJump = true;
    };

    const reset = () => {
      stop();
      finished = false;
      attempts = 0;
      setAttempts(0);
      pointsLost = 0;
      costEl.textContent = '0';
      editor.markLine(null);
      accumulator = 0;
      respawn();
      draw();
      hideBanner();
      say('Press <kbd>Space</kbd> to start. Then press it again to jump.');
    };

    /**
     * The rule owns the constants and the step; the engine owns everything the
     * lesson is not about. `apply` swaps the step in mid-run, so an edit shows
     * up on the very next frame without restarting the game.
     */
    const editor = createRuleEditor<Step>({
      root,
      compile(src) {
        const made = new Function(
          `"use strict";${src};return typeof step === 'function' ? step : null;`,
        )();
        if (!made) throw new Error('No function called step is defined.');
        return made as Step;
      },
      apply: (next) => (step = next),
      render: () => draw(),
    });

    for (const b of jumpBtns) b.addEventListener('click', onJump);
    resetBtn.addEventListener('click', reset);

    /**
     * How much of the game is on screen. Space is only taken when the game is
     * most of what you're looking at.
     *
     * The listener has to be on the document: `root` is a div, so it never
     * receives a key press unless focus already sits on a control inside it,
     * and from a cold load focus is on the body — which is why "press Space"
     * used to scroll the page instead of starting the game.
     *
     * Taking Space page-wide would be worse, though: it's Page Down for anyone
     * reading by keyboard. Gating on 60% visibility splits it — scrolling past
     * keeps Space, and once the game fills the screen Space plays it.
     */
    /** Fraction of the picture currently on screen, measured when asked rather
     *  than cached from the observer — the observer's first delivery is async,
     *  and a gate that silently fails closed until it arrives would drop the
     *  very first Space press, which is the one being complained about. */
    const visibleFraction = () => {
      const r = stage.getBoundingClientRect();
      if (r.height <= 0) return 0;
      const shown = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
      return Math.max(0, Math.min(shown / r.height, 1));
    };

    const typingInto = (el: Element | null) =>
      !!el &&
      (el.matches('input, textarea, select') || !!el.closest('[contenteditable]:not([contenteditable="false"])'));

    document.addEventListener('keydown', (e) => {
      if (e.key !== ' ' && e.key !== 'Spacebar' && e.key !== 'ArrowUp') return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (typingInto(document.activeElement)) return;

      // A focused control inside the game counts however little is on screen —
      // the reader has clearly chosen it. Otherwise it has to dominate the view.
      const engaged = root.contains(document.activeElement) || visibleFraction() >= 0.6;
      if (!engaged || finished) return;

      e.preventDefault();
      onJump();
    });

    // Stop the loop when it scrolls away; nothing is worth a background rAF.
    const io = new IntersectionObserver(
      (entries) => {
        const ratio = entries[entries.length - 1].intersectionRatio;
        if (ratio < 0.2 && running) {
          stop();
          say('Paused. Press <kbd>Space</kbd>, or tap the picture, to pick it up again.');
        }
      },
      { threshold: [0, 0.2, 0.6, 0.9] },
    );
    // The picture, not the whole component: stacked on a narrow screen the
    // component is far taller than the viewport, so its ratio could never
    // reach 0.6 and Space would never engage.
    io.observe(stage);

    draw();
  }
</script>
